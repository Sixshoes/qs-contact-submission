---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const clientId = (import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '').trim();
const sheetIdEnv = (import.meta.env.PUBLIC_GOOGLE_SHEET_ID || '').trim();
const sheetNameHint = (import.meta.env.PUBLIC_GOOGLE_SHEET_NAME || 'QS 2028 聯絡人提報').trim();
---

<Layout title="QS 聯絡人 Pool 現況">
  <div class="page-deco" aria-hidden="true"></div>
  <div class="page-content min-h-screen">
    <header class="site-header relative overflow-hidden border-b border-fgu/30 bg-gradient-to-br from-fgu via-fgu-dark to-fgu-deep text-white">
      <div class="relative mx-auto max-w-5xl px-4 py-8 sm:px-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-sm font-medium text-white/80">Fo Guang University · 管理檢視</p>
            <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">聯絡人 Pool 現況</h1>
            <p class="mt-2 max-w-2xl text-sm text-white/85">以 Google 帳號登入後，讀取你的試算表並顯示目前匯總狀態。</p>
          </div>
          <a href={base} class="rounded-lg border border-white/30 bg-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/20">
            ← 返回提交表單
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl space-y-6 px-4 py-8 sm:px-6">
      <section id="login-panel" class="card-panel shadow-md">
        <h2 class="panel-title">
          <span class="panel-title-mark" aria-hidden="true"></span>
          Google 登入
        </h2>
        <p class="mt-3 text-sm text-slate-600">
          請用擁有試算表權限的帳號登入（例如 <code class="rounded bg-slate-100 px-1">yitingchen@gm.fgu.edu.tw</code>）。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button type="button" id="btn-google-login" class="btn-primary px-5 py-2.5" disabled={!clientId}>
            使用 Google 登入
          </button>
          <button type="button" id="btn-logout" class="btn-secondary px-4 py-2 hidden">登出</button>
          <p id="login-user" class="text-sm text-slate-600"></p>
        </div>
        {!clientId && (
          <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
            尚未設定 <code>PUBLIC_GOOGLE_CLIENT_ID</code>。請先在 Google Cloud 建立 OAuth 用戶端，再寫入環境變數後重新部署。
          </p>
        )}
        <p id="login-error" class="mt-3 hidden text-sm text-red-700" role="alert"></p>
      </section>

      <section id="pool-panel" class="hidden space-y-6">
        <div class="card-panel shadow-md">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="panel-title">
              <span class="panel-title-mark" aria-hidden="true"></span>
              Pool 摘要
            </h2>
            <div class="flex flex-wrap gap-2">
              <button type="button" id="btn-refresh" class="btn-secondary px-4 py-2 text-sm">重新整理</button>
              <a id="link-open-sheet" href="#" target="_blank" rel="noopener" class="btn-qs px-4 py-2 text-sm hidden">
                在 Google 試算表開啟
              </a>
            </div>
          </div>
          <p id="sheet-meta" class="mt-3 text-sm text-slate-600"></p>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            <div class="rounded-xl border border-fgu/15 bg-fgu-light/60 px-4 py-3">
              <p class="text-xs font-medium text-fgu-dark">提交批次數</p>
              <p id="stat-submissions" class="mt-1 text-2xl font-bold text-fgu-deep">—</p>
            </div>
            <div class="rounded-xl border border-fgu/15 bg-white px-4 py-3">
              <p class="text-xs font-medium text-fgu-dark">學術聯絡人</p>
              <p id="stat-academic" class="mt-1 text-2xl font-bold text-fgu-deep">—</p>
            </div>
            <div class="rounded-xl border border-qs/30 bg-qs-light/50 px-4 py-3">
              <p class="text-xs font-medium text-amber-900">雇主聯絡人</p>
              <p id="stat-employer" class="mt-1 text-2xl font-bold text-amber-950">—</p>
            </div>
          </div>
          <p id="stat-updated" class="mt-3 text-xs text-slate-500"></p>
        </div>

        <div class="card-panel shadow-md overflow-x-auto">
          <h3 class="panel-title">
            <span class="panel-title-mark" aria-hidden="true"></span>
            最近提交紀錄
          </h3>
          <div id="table-submissions" class="mt-4"></div>
        </div>

        <div class="card-panel shadow-md overflow-x-auto">
          <h3 class="panel-title">
            <span class="panel-title-mark" aria-hidden="true"></span>
            學術聯絡人（最近）
          </h3>
          <div id="table-academic" class="mt-4"></div>
        </div>

        <div class="card-panel shadow-md overflow-x-auto">
          <h3 class="panel-title">
            <span class="panel-title-mark" aria-hidden="true"></span>
            雇主聯絡人（最近）
          </h3>
          <div id="table-employer" class="mt-4"></div>
        </div>
      </section>
    </main>
  </div>

  <script is:inline define:vars={{ clientId, sheetIdEnv, sheetNameHint, base }}>
    const SCOPES = [
      'https://www.googleapis.com/auth/spreadsheets.readonly',
      'https://www.googleapis.com/auth/drive.metadata.readonly',
      'https://www.googleapis.com/auth/userinfo.email',
    ].join(' ');

    const SHEETS = {
      submissions: '提交紀錄',
      academic: '學術聯絡人',
      employer: '雇主聯絡人',
    };

    let accessToken = '';
    let tokenClient = null;
    let activeSheet = { id: sheetIdEnv || '', name: '', url: '' };

    const $ = (id) => document.getElementById(id);

    function showError(msg) {
      const el = $('login-error');
      if (!msg) {
        el.classList.add('hidden');
        el.textContent = '';
        return;
      }
      el.textContent = msg;
      el.classList.remove('hidden');
    }

    function renderTable(containerId, values, maxRows = 30) {
      const el = $(containerId);
      if (!values || values.length < 2) {
        el.innerHTML = '<p class="text-sm text-slate-500">尚無資料</p>';
        return;
      }
      const headers = values[0];
      const rows = values.slice(1).slice(-maxRows).reverse();
      const th = headers.map((h) => `<th class="whitespace-nowrap border-b border-slate-200 px-2 py-2 text-left text-xs font-semibold text-slate-600">${escapeHtml(h)}</th>`).join('');
      const tr = rows
        .map((row) => {
          const tds = headers
            .map((_, i) => `<td class="max-w-[14rem] truncate border-b border-slate-100 px-2 py-2 text-xs text-slate-700" title="${escapeAttr(row[i] ?? '')}">${escapeHtml(row[i] ?? '')}</td>`)
            .join('');
          return `<tr class="hover:bg-slate-50">${tds}</tr>`;
        })
        .join('');
      el.innerHTML = `<table class="min-w-full border-collapse"><thead><tr>${th}</tr></thead><tbody>${tr}</tbody></table>`;
    }

    function escapeHtml(s) {
      return String(s)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function escapeAttr(s) {
      return escapeHtml(s).replaceAll("'", '&#39;');
    }

    function dataRows(values) {
      if (!values || values.length < 2) return 0;
      return values.length - 1;
    }

    async function apiGet(url) {
      const res = await fetch(url, {
        headers: { Authorization: `Bearer ${accessToken}` },
      });
      if (!res.ok) {
        const text = await res.text();
        throw new Error(`API ${res.status}：${text.slice(0, 180)}`);
      }
      return res.json();
    }

    async function resolveSheet() {
      if (activeSheet.id) {
        activeSheet.url = `https://docs.google.com/spreadsheets/d/${activeSheet.id}/edit`;
        activeSheet.name = activeSheet.name || sheetNameHint;
        return activeSheet;
      }
      const q = encodeURIComponent(
        `name = '${sheetNameHint.replaceAll("'", "\\'")}' and mimeType = 'application/vnd.google-apps.spreadsheet' and trashed = false`,
      );
      const data = await apiGet(
        `https://www.googleapis.com/drive/v3/files?q=${q}&fields=files(id,name,webViewLink)&pageSize=5`,
      );
      const files = data.files || [];
      if (!files.length) {
        throw new Error(`在 Drive 找不到名為「${sheetNameHint}」的試算表。請確認檔名，或設定 PUBLIC_GOOGLE_SHEET_ID。`);
      }
      activeSheet = {
        id: files[0].id,
        name: files[0].name,
        url: files[0].webViewLink || `https://docs.google.com/spreadsheets/d/${files[0].id}/edit`,
      };
      return activeSheet;
    }

    async function loadPool() {
      showError('');
      $('sheet-meta').textContent = '讀取中…';
      const sheet = await resolveSheet();
      const ranges = [SHEETS.submissions, SHEETS.academic, SHEETS.employer]
        .map((r) => `ranges=${encodeURIComponent(r)}`)
        .join('&');
      const batch = await apiGet(
        `https://sheets.googleapis.com/v4/spreadsheets/${encodeURIComponent(sheet.id)}/values:batchGet?${ranges}`,
      );
      const valueRanges = batch.valueRanges || [];
      const byTitle = {};
      valueRanges.forEach((vr) => {
        const title = (vr.range || '').split('!')[0].replaceAll("'", '');
        byTitle[title] = vr.values || [];
      });

      const submissions = byTitle[SHEETS.submissions] || [];
      const academic = byTitle[SHEETS.academic] || [];
      const employer = byTitle[SHEETS.employer] || [];

      $('stat-submissions').textContent = String(dataRows(submissions));
      $('stat-academic').textContent = String(dataRows(academic));
      $('stat-employer').textContent = String(dataRows(employer));
      $('sheet-meta').textContent = `試算表：${sheet.name}`;
      $('stat-updated').textContent = `更新時間：${new Date().toLocaleString('zh-TW', { hour12: false })}`;

      const open = $('link-open-sheet');
      open.href = sheet.url;
      open.classList.remove('hidden');

      renderTable('table-submissions', submissions, 40);
      renderTable('table-academic', academic, 40);
      renderTable('table-employer', employer, 40);
      $('pool-panel').classList.remove('hidden');
    }

    async function fetchUserEmail() {
      try {
        const me = await apiGet('https://www.googleapis.com/oauth2/v3/userinfo');
        return me.email || '';
      } catch {
        return '';
      }
    }

    function onTokenResponse(resp) {
      if (resp.error) {
        showError(resp.error_description || resp.error);
        return;
      }
      accessToken = resp.access_token;
      $('btn-logout').classList.remove('hidden');
      $('btn-google-login').textContent = '重新授權／切換帳號';
      fetchUserEmail().then((email) => {
        $('login-user').textContent = email ? `已登入：${email}` : '已登入';
      });
      loadPool().catch((err) => {
        console.error(err);
        showError(err.message || String(err));
      });
    }

    function initGis() {
      if (!clientId) return;
      if (!window.google?.accounts?.oauth2) {
        setTimeout(initGis, 200);
        return;
      }
      tokenClient = google.accounts.oauth2.initTokenClient({
        client_id: clientId,
        scope: SCOPES,
        callback: onTokenResponse,
      });
      $('btn-google-login').disabled = false;
    }

    $('btn-google-login')?.addEventListener('click', () => {
      showError('');
      if (!tokenClient) {
        showError('Google 登入元件尚未載入完成，請稍候再試。');
        return;
      }
      tokenClient.requestAccessToken({ prompt: accessToken ? '' : 'consent' });
    });

    $('btn-logout')?.addEventListener('click', () => {
      if (accessToken && window.google?.accounts?.oauth2) {
        google.accounts.oauth2.revoke(accessToken, () => {});
      }
      accessToken = '';
      activeSheet = { id: sheetIdEnv || '', name: '', url: '' };
      $('btn-logout').classList.add('hidden');
      $('login-user').textContent = '';
      $('btn-google-login').textContent = '使用 Google 登入';
      $('pool-panel').classList.add('hidden');
      showError('');
    });

    $('btn-refresh')?.addEventListener('click', () => {
      loadPool().catch((err) => {
        console.error(err);
        showError(err.message || String(err));
      });
    });

    window.__qsPoolInit = initGis;
  </script>
  <script is:inline src="https://accounts.google.com/gsi/client" async defer onload="window.__qsPoolInit && window.__qsPoolInit()"></script>
  <script is:inline>
    // 若 gsi 已快取完成，onload 可能不觸發
    if (window.google?.accounts?.oauth2) window.__qsPoolInit && window.__qsPoolInit();
  </script>
</Layout>
