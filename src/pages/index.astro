---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout>
  <div class="page-deco" aria-hidden="true"></div>
  <div class="page-content min-h-screen">
    <!-- Header -->
    <header class="relative overflow-hidden border-b border-fgu/30 bg-gradient-to-br from-fgu via-fgu-dark to-fgu-deep text-white shadow-lg">
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-qs/15 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-10 h-48 w-48 rounded-full bg-sage/20 blur-2xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-1/4 top-1/2 h-32 w-32 -translate-y-1/2 rounded-full bg-warm-gold/10 blur-2xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-5xl px-4 py-8 sm:px-6">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <img
              src={`${base}images/fgu-logo.png`}
              alt="佛光大學校徽"
              class="h-16 w-16 shrink-0 rounded-full object-cover shadow-md ring-2 ring-white/30 sm:h-20 sm:w-20"
              width="80"
              height="80"
            />
            <div>
              <p class="text-sm font-medium text-white/80">Fo Guang University</p>
              <h1 class="mt-0.5 text-xl font-bold tracking-tight sm:text-2xl lg:text-3xl">
                QS 學術與雇主問卷聯絡人提交系統
              </h1>
            </div>
          </div>
          <div class="flex items-center gap-3 self-start sm:self-center">
            <span class="hidden text-xs font-medium uppercase tracking-wider text-white/60 sm:inline">Powered by</span>
            <img
              src={`${base}images/qs-logo.png`}
              alt="QS Logo"
              class="h-12 w-12 shrink-0 rounded-lg shadow-md ring-2 ring-white/20 sm:h-14 sm:w-14"
              width="56"
              height="56"
            />
          </div>
        </div>
        <p class="mt-5 max-w-3xl text-sm leading-relaxed text-white/85 sm:text-base">
          依 QS Global Academic and Employer Survey Guidelines 填寫聯絡人資料，系統將自動拆分為學術／雇主 Excel 檔供上傳。
        </p>
        <div class="mt-4 rounded-xl border border-white/20 bg-white/10 px-4 py-3 backdrop-blur-sm">
          <p class="text-sm font-semibold text-white">QS Global Academic and Employer Survey Guidelines</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <a
              href={`${base}docs/qs-guidelines-en.pdf`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-white/25 bg-white/15 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-white/25"
            >
              <span aria-hidden="true">📄</span>
              English（PDF 預覽）
            </a>
            <a
              href={`${base}docs/qs-guidelines-zh.pdf`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-white/25 bg-white/15 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-white/25"
            >
              <span aria-hidden="true">📄</span>
              中文譯本（PDF 預覽）
            </a>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-2" aria-hidden="true">
          <div class="header-accent-line h-1 w-20 rounded-full shadow-sm"></div>
          <div class="h-1.5 w-1.5 rounded-full bg-sage-light/80"></div>
          <div class="h-1 w-8 rounded-full bg-white/30"></div>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      <!-- Step indicator -->
      <nav aria-label="進度" class="card-panel mb-8">
        <ol class="flex flex-wrap items-center justify-center gap-3 text-sm sm:gap-6">
          <li id="step-indicator-1" class="flex items-center gap-2 font-semibold text-fgu">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-full bg-fgu text-sm font-bold text-white shadow-md">1</span>
            <span>填寫</span>
          </li>
          <li class="step-connector hidden h-px w-10 sm:block" aria-hidden="true"></li>
          <li id="step-indicator-2" class="flex items-center gap-2 text-slate-400">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-full bg-slate-200 text-sm font-bold text-slate-600">2</span>
            <span>預覽與匯出 Excel</span>
          </li>
          <li class="step-connector hidden h-px w-10 sm:block" aria-hidden="true"></li>
          <li id="step-indicator-3" class="flex items-center gap-2 text-slate-400">
            <span class="step-badge flex h-9 w-9 items-center justify-center rounded-full bg-slate-200 text-sm font-bold text-slate-600">3</span>
            <span>下載與回信範本</span>
          </li>
        </ol>
      </nav>

      <!-- ========== STEP 1 ========== -->
      <section id="step-1" class="space-y-6">
        <p class="rounded-xl border border-slate-200 bg-white/80 px-4 py-3 text-sm text-slate-600 shadow-sm">
          學術聯絡人與雇主聯絡人各最多 10 筆。
        </p>

        <details class="rounded-xl border border-fgu/15 bg-fgu-light/50 px-4 py-3 text-sm shadow-sm">
          <summary class="cursor-pointer font-medium text-fgu-dark">Email 填寫說明（依 QS 方法論 §2.8）</summary>
          <ul class="mt-3 space-y-2 text-xs leading-relaxed text-slate-600">
            <li>• 請填寫聯絡人<strong>個人公務／官方信箱</strong>，避免使用 team@、info@、admissions@ 等共用或團隊信箱。</li>
            <li>• 每位聯絡人僅填<strong>一組</strong> email。</li>
            <li>• 不同聯絡人請使用<strong>不同信箱</strong>；多人共用同一信箱時，QS 僅會寄送一次問卷邀請。</li>
            <li>• 不可含空白，亦不可含 <code class="rounded bg-white px-1">[ ] { } ( ) ; : , &lt; &gt; ' # ~ = +</code> 等符號。</li>
          </ul>
        </details>

        <div class="card-panel sticky top-0 z-20 space-y-4 backdrop-blur supports-[backdrop-filter]:bg-white/95">
          <div class="flex items-center gap-2">
            <span class="inline-block h-5 w-1 rounded-full bg-gradient-to-b from-fgu to-sage" aria-hidden="true"></span>
            <h2 class="text-lg font-semibold text-slate-900">提交資訊</h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="submitter-unit" class="mb-1.5 block text-sm font-medium text-slate-700">
                提交單位 (Department / Unit) <span class="text-red-500">*</span>
              </label>
              <input id="submitter-unit" type="text" required placeholder="例如：歷史學系、永續辦公室、國際處..." class="input-field" />
            </div>
            <div>
              <label for="submitter-name" class="mb-1.5 block text-sm font-medium text-slate-700">
                提交人姓名 (Submitter Name) <span class="text-red-500">*</span>
              </label>
              <input id="submitter-name" type="text" required placeholder="請輸入您的姓名" class="input-field" />
            </div>
          </div>
        </div>

        <!-- 學術聯絡人 -->
        <section id="section-academic" class="section-academic">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-fgu/15 to-sage-light text-sm font-bold text-fgu">A</span>
              <div>
                <h2 class="text-lg font-semibold text-fgu-dark">學術聯絡人 (Academic)</h2>
              </div>
            </div>
            <span id="academic-count" class="rounded-full bg-white px-2.5 py-0.5 text-sm font-medium text-fgu shadow-sm">(0 / 10)</span>
          </div>
          <div id="academic-contacts-container" class="space-y-5"></div>
          <p id="academic-empty-hint" class="hidden rounded-xl border border-dashed border-fgu/30 bg-white/70 px-4 py-8 text-center text-sm text-slate-500">
            尚未新增學術聯絡人，請點下方按鈕新增。
          </p>
          <div class="mt-4 flex justify-end">
            <button type="button" id="btn-add-academic" class="btn-primary">
              <span aria-hidden="true">＋</span> 新增學術聯絡人
            </button>
          </div>
        </section>

        <!-- 雇主聯絡人 -->
        <section id="section-employer" class="section-employer">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-start gap-3">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-qs/20 to-warm-gold-light text-sm font-bold text-amber-900">E</span>
              <div>
                <h2 class="text-lg font-semibold text-amber-900">雇主聯絡人 (Employer)</h2>
              </div>
            </div>
            <span id="employer-count" class="rounded-full bg-white px-2.5 py-0.5 text-sm font-medium text-amber-800 shadow-sm">(0 / 10)</span>
          </div>
          <div id="employer-contacts-container" class="space-y-5"></div>
          <p id="employer-empty-hint" class="hidden rounded-xl border border-dashed border-qs/40 bg-white/70 px-4 py-8 text-center text-sm text-slate-500">
            尚未新增雇主聯絡人，請點下方按鈕新增。
          </p>
          <div class="mt-4 flex justify-end">
            <button type="button" id="btn-add-employer" class="btn-qs">
              <span aria-hidden="true">＋</span> 新增雇主聯絡人
            </button>
          </div>
        </section>

        <p id="form-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 shadow-sm" role="alert"></p>

        <div class="flex justify-end pt-2">
          <button type="button" id="btn-preview" class="btn-primary px-6 py-3 text-base shadow-lg">
            預覽與確認名單 →
          </button>
        </div>
      </section>

      <!-- ========== STEP 2 ========== -->
      <section id="step-2" class="hidden space-y-6">
        <div class="card-panel shadow-md">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-slate-900">確認提報名單</h2>
            <button type="button" id="btn-back" class="btn-secondary">← 返回修改</button>
          </div>
          <p id="preview-meta" class="mb-4 rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-600"></p>
          <div id="preview-list" class="space-y-4"></div>
        </div>

        <div class="rounded-2xl border border-sage/25 bg-gradient-to-br from-sage-light/80 to-white p-5 shadow-sm">
          <label for="confirm-unlock" class="mb-2 block text-sm font-medium text-fgu-dark">
            防呆解鎖：請輸入「我確定提交」以解鎖提交按鈕
          </label>
          <input id="confirm-unlock" type="text" autocomplete="off" placeholder="我確定提交" class="input-field max-w-md" />
          <div class="mt-4">
            <button type="button" id="btn-submit" disabled class="btn-qs px-6 disabled:bg-slate-300 disabled:text-slate-500">
              提交並匯出 Excel
            </button>
            <p class="mt-2 text-xs leading-relaxed text-slate-500">
              提交後將自動正規化資料並產生 Excel 檔，於下一步分別下載後再寄信即可。
            </p>
          </div>
        </div>
      </section>

      <!-- ========== STEP 3 ========== -->
      <section id="step-3" class="hidden space-y-6">
        <div class="card-panel text-center shadow-md">
          <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-sage/15 text-2xl text-sage" aria-hidden="true">✓</div>
          <h2 class="text-xl font-bold text-fgu-dark">寄件完成</h2>
          <p class="mt-2 text-sm text-slate-600">請依下方步驟下載 Excel 並寄信給下列收件人即可完成提交。</p>
        </div>

        <!-- 下載 -->
        <div class="card-panel shadow-md">
          <div class="flex items-center gap-2">
            <span class="inline-block h-5 w-1 rounded-full bg-gradient-to-b from-fgu to-sage" aria-hidden="true"></span>
            <h3 class="text-lg font-semibold text-slate-900">下載</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            請下載本次產生的 Excel 檔案。
          </p>
          <div id="download-panel" class="mt-4 hidden rounded-xl border border-fgu/20 bg-fgu-light/30 px-4 py-4">
            <div id="download-buttons" class="flex flex-wrap gap-2"></div>
          </div>
        </div>

        <!-- 回信範本 -->
        <div class="card-panel shadow-md">
          <div class="flex items-center gap-2">
            <span class="inline-block h-5 w-1 rounded-full bg-gradient-to-b from-fgu to-sage" aria-hidden="true"></span>
            <h3 class="text-lg font-semibold text-slate-900">回信範本</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            下載完成後，請將 Excel 以 Email 寄給<strong>奕廷</strong>（<code class="rounded bg-slate-100 px-1 text-fgu">yitingchen@mail.fgu.edu.tw</code>）、<strong>嘉玲</strong>（<code class="rounded bg-slate-100 px-1 text-fgu">chlchang@mail.fgu.edu.tw</code>）。
            若需要，可複製下方<strong>收件人、主旨、內文</strong>作為寄信參考。主旨、內文、附件檔名皆可依需要自行修改。
          </p>

          <!-- 附件說明 -->
          <div class="mt-4 rounded-xl border border-qs/25 bg-qs-light/50 p-4">
            <h4 class="text-sm font-semibold text-amber-900">附件注意事項</h4>
            <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-slate-700">
              <li>• 若有填寫<strong>學術</strong>聯絡人，請附上 <strong>QS_學術聯絡人名單</strong> Excel（1 個檔案，內含「中文」「English」「合併說明」分頁）。</li>
              <li>• 若有填寫<strong>雇主</strong>聯絡人，請附上 <strong>QS_雇主聯絡人名單</strong> Excel（1 個檔案，內含「中文」「English」「合併說明」分頁）。</li>
              <li>• 兩類都有填寫時，請<strong>一次寄出 2 個附件</strong>即可，不必分開寄兩封信。</li>
              <li>• 請確認下載資料夾中的檔案可正常開啟後再寄出。</li>
            </ul>
            <div class="mt-3 rounded-lg border border-amber-200/60 bg-white p-3">
              <p class="text-xs font-medium text-slate-500">本次附件清單</p>
              <ul id="attachment-list" class="mt-1.5 space-y-1 text-sm font-medium text-slate-800"></ul>
            </div>
          </div>

          <div class="mt-6 space-y-4">
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div class="mb-2 flex items-center justify-between gap-2">
                <span class="text-sm font-medium text-slate-700">收件人</span>
                <button type="button" data-copy-target="copy-to" class="copy-btn rounded-md border border-fgu/20 bg-white px-2.5 py-1 text-xs font-medium text-fgu transition hover:bg-fgu-light">
                  複製
                </button>
              </div>
              <pre id="copy-to" class="whitespace-pre-wrap break-all font-sans text-sm text-slate-800">yitingchen@mail.fgu.edu.tw; chlchang@mail.fgu.edu.tw</pre>
            </div>

            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div class="mb-2 flex items-center justify-between gap-2">
                <span class="text-sm font-medium text-slate-700">信件主旨</span>
                <button type="button" data-copy-target="copy-subject" class="copy-btn rounded-md border border-fgu/20 bg-white px-2.5 py-1 text-xs font-medium text-fgu transition hover:bg-fgu-light">
                  複製
                </button>
              </div>
              <pre id="copy-subject" class="whitespace-pre-wrap break-all font-sans text-sm text-slate-800"></pre>
            </div>

            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div class="mb-2 flex items-center justify-between gap-2">
                <span class="text-sm font-medium text-slate-700">信件內文</span>
                <button type="button" data-copy-target="copy-body" class="copy-btn rounded-md border border-fgu/20 bg-white px-2.5 py-1 text-xs font-medium text-fgu transition hover:bg-fgu-light">
                  複製
                </button>
              </div>
              <pre id="copy-body" class="whitespace-pre-wrap font-sans text-sm leading-relaxed text-slate-800">奕廷、嘉玲 您好：

謹此提報本單位 QS 世界大學排名學術／雇主問卷聯絡人名單，請查收協助後續作業，謝謝。

■ 提交單位：
■ 提交人姓名：
■ 提交內容：
■ 附件檔案：

敬祝
教安</pre>
            </div>
          </div>

          <p class="mt-4 text-xs leading-relaxed text-slate-500">
            以上收件人、主旨、內文僅供參考，實際寄信時可依需要自由調整。
          </p>
        </div>

        <div class="flex justify-center">
          <button type="button" id="btn-reset" class="btn-secondary px-6 py-2.5 font-semibold">
            重新填寫一份新表單
          </button>
        </div>
      </section>
    </main>

    <footer class="relative mt-8 border-t border-fgu/10 bg-white/90 py-8 backdrop-blur-sm">
      <div class="footer-bar absolute inset-x-0 top-0 h-1" aria-hidden="true"></div>
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 pt-2 sm:flex-row sm:justify-between sm:px-6">
        <div class="flex items-center gap-3">
          <img src={`${base}images/fgu-logo.png`} alt="" class="h-10 w-10 rounded-full object-cover" width="40" height="40" aria-hidden="true" />
          <p class="text-xs text-slate-500">Fo Guang University · QS Contact Submission</p>
        </div>
        <img src={`${base}images/qs-logo.png`} alt="QS" class="h-8 w-8 rounded opacity-80" width="32" height="32" />
      </div>
    </footer>
  </div>

  <!-- Contact card template -->
  <template id="contact-card-template">
    <article class="contact-card border-slate-200" data-contact-id="">
      <div class="mb-4 flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-3">
        <h3 class="contact-card-title text-base font-semibold text-slate-900">聯絡人 #1</h3>
        <button type="button" class="btn-remove-contact rounded-md border border-red-200 bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700 transition hover:bg-red-100">
          刪除
        </button>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 [&>div]:min-w-0">
        <!-- Title -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Title <span class="text-red-500">*</span>
          </label>
          <select class="field-title input-field" required>
            <option value="">請選擇</option>
          </select>
          <input type="text" class="field-title-other input-field mt-2 hidden" placeholder="請填寫其他稱謂" />
        </div>

        <!-- First Name -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            First Name <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-first-name input-field" required placeholder="名字（不含空白前後）" />
        </div>

        <!-- Last Name -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Last Name <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-last-name input-field" required placeholder="姓氏（不含空白前後）" />
        </div>

        <!-- Job Title / Position -->
        <div>
          <label class="label-job-title mb-1.5 block text-sm font-medium text-slate-700">
            Job Title <span class="text-red-500">*</span>
          </label>
          <select class="field-job-title input-field" required>
            <option value="">請選擇</option>
          </select>
          <input type="text" class="field-job-other input-field mt-2 hidden" placeholder="請填寫具體職稱（將輸出為 Others (xxx)）" />
        </div>

        <!-- Department / Industry -->
        <div>
          <label class="label-dept-industry mb-1.5 block text-sm font-medium text-slate-700">
            Department <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-department input-field" placeholder="請填寫完整系所名稱" />
          <select class="field-industry input-field hidden">
            <option value="">請選擇產業</option>
          </select>
          <input type="text" class="field-industry-other input-field mt-2 hidden" placeholder="請填寫具體產業（將輸出為 Other (xxx)）" />
        </div>

        <!-- Institution / Company Name -->
        <div>
          <label class="label-institution mb-1.5 block text-sm font-medium text-slate-700">
            Institution <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-institution input-field" required placeholder="機構正式名稱" />
        </div>

        <!-- Country -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Country or Territory <span class="text-red-500">*</span>
          </label>
          <select class="field-country input-field" required>
          </select>
          <input type="text" class="field-country-other input-field mt-2 hidden" placeholder="請填寫其他國家／地區名稱" />
        </div>

        <!-- Email -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Email <span class="text-red-500">*</span>
          </label>
          <input type="email" class="field-email input-field" required placeholder="例：name@univ.edu.tw（個人公務信箱）" />
          <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
            依 QS §2.8：個人官方信箱、僅填一組、勿填共用信箱、勿與其他聯絡人重複。
          </p>
        </div>

        <!-- Subject (academic only) -->
        <div class="subject-wrap">
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Subject <span class="text-red-500">*</span>
          </label>
          <select class="field-subject input-field">
            <option value="">請選擇學術領域</option>
          </select>
          <input type="text" class="field-subject-other input-field mt-2 hidden" placeholder="請填寫具體學術領域（將輸出為 Others (xxx)）" />
        </div>

        <!-- Phone -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Phone <span class="text-slate-400">(選填)</span>
          </label>
          <input type="tel" class="field-phone input-field" placeholder="含國際碼，例如 +886..." />
        </div>
      </div>
    </article>
  </template>

  <script>
    import {
      downloadBlobsSequential,
      downloadBlob,
      createAcademicWorkbookBlob,
      createEmployerWorkbookBlob,
    } from '../scripts/excel-export.js';
    import {
      TITLES,
      ACADEMIC_JOB_TITLES,
      EMPLOYER_JOB_TITLES,
      INDUSTRIES,
      COUNTRIES,
      DEFAULT_COUNTRY,
      SUBJECTS,
      ACADEMIC_EXCEL_HEADERS_EN,
      ACADEMIC_EXCEL_HEADERS_ZH,
      EMPLOYER_EXCEL_HEADERS_EN,
      EMPLOYER_EXCEL_HEADERS_ZH,
      SOURCE_EN,
      SOURCE_ZH,
      bilingualLabel,
      optionText,
      findOption,
    } from '../data/qs-options.js';

    const STORAGE_KEY = 'qs-contact-form-v3';
    const MAX_CONTACTS = 10;
    const UNLOCK_PHRASE = '我確定提交';
    const EMAIL_FORBIDDEN = /[\[\]{}();:,<>'#~=+"¬`!]/;

    /** @type {{ id: string, type: string, title: string, titleOther: string, firstName: string, lastName: string, jobTitle: string, jobOther: string, department: string, industry: string, industryOther: string, institution: string, country: string, countryOther: string, email: string, subject: string, subjectOther: string, phone: string }[]} */
    let academicContacts = [];
    /** @type {typeof academicContacts} */
    let employerContacts = [];
    let currentStep = 1;

    const $ = (sel, root = document) => root.querySelector(sel);
    const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];

    function uid() {
      return `c_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    }

    /** @param {'academic'|'employer'} type */
    function emptyContact(type) {
      return {
        id: uid(),
        type,
        title: '',
        titleOther: '',
        firstName: '',
        lastName: '',
        jobTitle: '',
        jobOther: '',
        department: '',
        industry: '',
        industryOther: '',
        institution: '',
        country: DEFAULT_COUNTRY,
        countryOther: '',
        email: '',
        subject: '',
        subjectOther: '',
        phone: '',
      };
    }

    /** @param {'academic'|'employer'} type */
    function getList(type) {
      return type === 'academic' ? academicContacts : employerContacts;
    }

    /** @param {'academic'|'employer'} type */
    function setList(type, list) {
      if (type === 'academic') academicContacts = list;
      else employerContacts = list;
    }

    function findContact(id) {
      return academicContacts.find((c) => c.id === id) || employerContacts.find((c) => c.id === id) || null;
    }

    function fillSelect(select, options, { placeholder, selected } = {}) {
      if (!select) return;
      select.innerHTML = '';
      if (placeholder !== undefined) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = placeholder;
        select.appendChild(opt);
      }
      for (const item of options) {
        const en = typeof item === 'string' ? item : item.en;
        const label = typeof item === 'string' ? item : bilingualLabel(item);
        const opt = document.createElement('option');
        opt.value = en;
        opt.textContent = label;
        if (en === selected) opt.selected = true;
        select.appendChild(opt);
      }
    }

    function optionEns(list) {
      return list.map((item) => (typeof item === 'string' ? item : item.en));
    }

    function displayOpt(list, en) {
      const found = findOption(list, en);
      return found ? bilingualLabel(found) : trimVal(en);
    }

    function trimVal(v) {
      return String(v ?? '').trim();
    }

    /** 去除前後空白，並將連續空白合併為單一空格 */
    function collapseSpaces(v) {
      return trimVal(v).replace(/\s+/g, ' ');
    }

    /** QS §2.8：email 不含空白，統一小寫 */
    function normalizeEmail(v) {
      return trimVal(v).replace(/\s+/g, '').toLowerCase();
    }

    /** Phone 去除空白（保留 + 與數字等符號） */
    function normalizePhone(v) {
      return trimVal(v).replace(/\s+/g, '');
    }

    /** @param {typeof academicContacts[0]} c */
    function normalizeContact(c) {
      c.firstName = collapseSpaces(c.firstName);
      c.lastName = collapseSpaces(c.lastName);
      c.department = collapseSpaces(c.department);
      c.institution = collapseSpaces(c.institution);
      c.email = normalizeEmail(c.email);
      c.phone = normalizePhone(c.phone);
      c.titleOther = c.title === 'Other' ? collapseSpaces(c.titleOther) : '';
      c.jobOther = c.jobTitle === 'Other' ? collapseSpaces(c.jobOther) : '';
      c.industryOther = c.industry === 'Other' ? collapseSpaces(c.industryOther) : '';
      c.countryOther = c.country === 'Other' ? collapseSpaces(c.countryOther) : '';
      c.subjectOther = c.subject === 'Other' ? collapseSpaces(c.subjectOther) : '';
      return c;
    }

    function normalizeAllData() {
      $$('.contact-card').forEach(syncCardToModel);
      academicContacts.forEach(normalizeContact);
      employerContacts.forEach(normalizeContact);
      const unitEl = $('#submitter-unit');
      const nameEl = $('#submitter-name');
      if (unitEl) unitEl.value = collapseSpaces(unitEl.value);
      if (nameEl) nameEl.value = collapseSpaces(nameEl.value);
      renderAllCards();
      saveState();
    }

    function formatOther(otherText, lang = 'en') {
      const detail = trimVal(otherText);
      if (lang === 'zh') {
        return detail ? `其他 (${detail})` : '其他';
      }
      return detail ? `Others (${detail})` : 'Others';
    }

    function formatIndustryOther(otherText, lang = 'en') {
      const detail = trimVal(otherText);
      if (lang === 'zh') {
        return detail ? `其他 (${detail})` : '其他';
      }
      return detail ? `Other (${detail})` : 'Other';
    }

    function formatSimpleOther(otherText, lang = 'en') {
      const detail = trimVal(otherText);
      if (lang === 'zh') {
        return detail ? `其他 (${detail})` : '其他';
      }
      return detail ? `Other (${detail})` : 'Other';
    }

    /** @param {'en'|'zh'} lang */
    function resolveJobTitle(c, lang = 'en') {
      const list = c.type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES;
      if (c.jobTitle === 'Other') return formatOther(c.jobOther, lang);
      return optionText(list, c.jobTitle, lang) || trimVal(c.jobTitle);
    }

    /** @param {'en'|'zh'} lang */
    function resolveDeptIndustry(c, lang = 'en') {
      if (c.type === 'academic') return trimVal(c.department);
      if (c.industry === 'Other') return formatIndustryOther(c.industryOther, lang);
      return optionText(INDUSTRIES, c.industry, lang) || trimVal(c.industry);
    }

    /** @param {'en'|'zh'} lang */
    function resolveSubject(c, lang = 'en') {
      if (c.type !== 'academic') return '';
      if (c.subject === 'Other') return formatOther(c.subjectOther, lang);
      return optionText(SUBJECTS, c.subject, lang) || trimVal(c.subject);
    }

    /** @param {'en'|'zh'} lang */
    function resolveTitle(c, lang = 'en') {
      if (c.title === 'Other') return formatSimpleOther(c.titleOther, lang);
      return optionText(TITLES, c.title, lang) || trimVal(c.title);
    }

    /** @param {'en'|'zh'} lang */
    function resolveCountry(c, lang = 'en') {
      if (c.country === 'Other') return formatSimpleOther(c.countryOther, lang);
      return optionText(COUNTRIES, c.country, lang) || trimVal(c.country);
    }

    function saveState() {
      const state = {
        step: currentStep,
        unit: trimVal($('#submitter-unit')?.value),
        submitter: trimVal($('#submitter-name')?.value),
        academicContacts,
        employerContacts,
      };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {
        /* ignore quota */
      }
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        // migrate v2 single-list format
        if (parsed.contacts?.length && !parsed.academicContacts && !parsed.employerContacts) {
          parsed.academicContacts = parsed.contacts.filter((c) => c.type === 'academic');
          parsed.employerContacts = parsed.contacts.filter((c) => c.type === 'employer');
        }
        return parsed;
      } catch {
        return null;
      }
    }

    function updateContactCount() {
      $('#academic-count').textContent = `(${academicContacts.length} / ${MAX_CONTACTS})`;
      $('#employer-count').textContent = `(${employerContacts.length} / ${MAX_CONTACTS})`;
      $('#btn-add-academic').disabled = academicContacts.length >= MAX_CONTACTS;
      $('#btn-add-employer').disabled = employerContacts.length >= MAX_CONTACTS;
      $('#btn-add-academic').closest('div')?.classList.toggle('hidden', academicContacts.length >= MAX_CONTACTS);
      $('#btn-add-employer').closest('div')?.classList.toggle('hidden', employerContacts.length >= MAX_CONTACTS);
      $('#academic-empty-hint').classList.toggle('hidden', academicContacts.length > 0);
      $('#employer-empty-hint').classList.toggle('hidden', employerContacts.length > 0);
    }

    function setStepIndicators(step) {
      for (let i = 1; i <= 3; i++) {
        const el = $(`#step-indicator-${i}`);
        const badge = el.querySelector('.step-badge');
        if (i === step) {
          el.className = 'flex items-center gap-2 font-semibold text-fgu';
          badge.className = 'step-badge flex h-9 w-9 items-center justify-center rounded-full bg-fgu text-sm font-bold text-white shadow-md';
        } else if (i < step) {
          el.className = 'flex items-center gap-2 font-medium text-sage';
          badge.className = 'step-badge flex h-9 w-9 items-center justify-center rounded-full bg-sage text-sm font-bold text-white shadow-sm';
        } else {
          el.className = 'flex items-center gap-2 text-slate-400';
          badge.className = 'step-badge flex h-9 w-9 items-center justify-center rounded-full bg-slate-200 text-sm font-bold text-slate-600';
        }
      }
    }

    function showStep(step) {
      currentStep = step;
      $('#step-1').classList.toggle('hidden', step !== 1);
      $('#step-2').classList.toggle('hidden', step !== 2);
      $('#step-3').classList.toggle('hidden', step !== 3);
      setStepIndicators(step);
      saveState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function applyTypeUI(card, type) {
      const label = $('.label-dept-industry', card);
      const labelJob = $('.label-job-title', card);
      const labelInst = $('.label-institution', card);
      const dept = $('.field-department', card);
      const industry = $('.field-industry', card);
      const industryOther = $('.field-industry-other', card);
      const subjectWrap = $('.subject-wrap', card);
      const jobSelect = $('.field-job-title', card);
      const instInput = $('.field-institution', card);
      const prevJob = jobSelect.value;

      fillSelect(jobSelect, type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES, {
        placeholder: '請選擇',
        selected: prevJob,
      });
      // If previous value not in new list, clear
      const jobEns = optionEns(type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES);
      if (!jobEns.includes(jobSelect.value)) {
        jobSelect.value = '';
      }

      if (type === 'academic') {
        labelJob.innerHTML = 'Job Title <span class="text-red-500">*</span>';
        label.innerHTML = 'Department <span class="text-red-500">*</span>';
        labelInst.innerHTML = 'Institution <span class="text-red-500">*</span>';
        instInput.placeholder = '機構正式名稱（聯絡人所屬大學）';
        dept.classList.remove('hidden');
        industry.classList.add('hidden');
        industryOther.classList.add('hidden');
        subjectWrap.classList.remove('hidden');
      } else {
        labelJob.innerHTML = 'Position <span class="text-red-500">*</span>';
        label.innerHTML = 'Industry <span class="text-red-500">*</span>';
        labelInst.innerHTML = 'Company Name <span class="text-red-500">*</span>';
        instInput.placeholder = '公司正式名稱';
        dept.classList.add('hidden');
        industry.classList.remove('hidden');
        subjectWrap.classList.add('hidden');
        toggleOtherInput(industry, industryOther);
      }

      toggleOtherInput(jobSelect, $('.field-job-other', card));
      if (type === 'academic') {
        toggleOtherInput($('.field-subject', card), $('.field-subject-other', card));
      }
    }

    function toggleOtherInput(selectEl, otherInput) {
      if (!selectEl || !otherInput) return;
      const isOther = selectEl.value === 'Other';
      otherInput.classList.toggle('hidden', !isOther);
      otherInput.required = isOther;
      if (!isOther) otherInput.value = '';
    }

    function syncCardToModel(card) {
      const id = card.dataset.contactId;
      const type = card.dataset.contactType;
      const c = findContact(id);
      if (!c) return;

      c.type = type;
      c.title = $('.field-title', card).value;
      c.titleOther = $('.field-title-other', card).value;
      c.firstName = $('.field-first-name', card).value;
      c.lastName = $('.field-last-name', card).value;
      c.jobTitle = $('.field-job-title', card).value;
      c.jobOther = $('.field-job-other', card).value;
      c.department = $('.field-department', card).value;
      c.industry = $('.field-industry', card).value;
      c.industryOther = $('.field-industry-other', card).value;
      c.institution = $('.field-institution', card).value;
      c.country = $('.field-country', card).value;
      c.countryOther = $('.field-country-other', card).value;
      c.email = $('.field-email', card).value;
      c.subject = $('.field-subject', card).value;
      c.subjectOther = $('.field-subject-other', card).value;
      c.phone = $('.field-phone', card).value;
      saveState();
    }

    /** @param {'academic'|'employer'} type */
    function renderContactCard(contact, index, type) {
      const tpl = $('#contact-card-template');
      const node = tpl.content.firstElementChild.cloneNode(true);
      node.dataset.contactId = contact.id;
      node.dataset.contactType = type;
      node.classList.add(type === 'academic' ? 'academic-card' : 'employer-card');
      if (type === 'academic') {
        node.classList.add('border-fgu/20');
      } else {
        node.classList.add('border-warm-gold/25');
      }

      const typeLabel = type === 'academic' ? '學術' : '雇主';
      $('.contact-card-title', node).textContent = `${typeLabel}聯絡人 #${index + 1}`;

      fillSelect($('.field-title', node), TITLES, { placeholder: '請選擇', selected: contact.title });
      fillSelect($('.field-industry', node), INDUSTRIES, { placeholder: '請選擇產業', selected: contact.industry });
      fillSelect($('.field-country', node), COUNTRIES, { selected: contact.country || DEFAULT_COUNTRY });
      fillSelect($('.field-subject', node), SUBJECTS, { placeholder: '請選擇學術領域', selected: contact.subject });

      $('.field-first-name', node).value = contact.firstName;
      $('.field-last-name', node).value = contact.lastName;
      $('.field-department', node).value = contact.department;
      $('.field-institution', node).value = contact.institution;
      $('.field-email', node).value = contact.email;
      $('.field-phone', node).value = contact.phone;

      applyTypeUI(node, type);
      $('.field-job-title', node).value = contact.jobTitle;

      const otherPairs = [
        ['.field-title', '.field-title-other', contact.titleOther],
        ['.field-job-title', '.field-job-other', contact.jobOther],
        ['.field-industry', '.field-industry-other', contact.industryOther],
        ['.field-country', '.field-country-other', contact.countryOther],
        ['.field-subject', '.field-subject-other', contact.subjectOther],
      ];
      for (const [sel, otherSel, saved] of otherPairs) {
        const selectEl = $(sel, node);
        const otherEl = $(otherSel, node);
        toggleOtherInput(selectEl, otherEl);
        if (selectEl?.value === 'Other' && saved) otherEl.value = saved;
      }

      node.addEventListener('input', () => syncCardToModel(node));
      node.addEventListener('change', (e) => {
        const t = e.target;
        if (t.classList.contains('field-title')) {
          toggleOtherInput(t, $('.field-title-other', node));
        }
        if (t.classList.contains('field-job-title')) {
          toggleOtherInput(t, $('.field-job-other', node));
        }
        if (t.classList.contains('field-industry')) {
          toggleOtherInput(t, $('.field-industry-other', node));
        }
        if (t.classList.contains('field-country')) {
          toggleOtherInput(t, $('.field-country-other', node));
        }
        if (t.classList.contains('field-subject')) {
          toggleOtherInput(t, $('.field-subject-other', node));
        }
        syncCardToModel(node);
      });

      $('.btn-remove-contact', node).addEventListener('click', () => {
        setList(type, getList(type).filter((c) => c.id !== contact.id));
        renderAllCards();
        saveState();
      });

      return node;
    }

    function renderAllCards() {
      const academicContainer = $('#academic-contacts-container');
      const employerContainer = $('#employer-contacts-container');
      if (!academicContainer || !employerContainer) return;

      academicContainer.innerHTML = '';
      employerContainer.innerHTML = '';
      try {
        academicContacts.forEach((c, i) => academicContainer.appendChild(renderContactCard(c, i, 'academic')));
        employerContacts.forEach((c, i) => employerContainer.appendChild(renderContactCard(c, i, 'employer')));
      } catch (err) {
        console.error(err);
        showError('聯絡人表單渲染失敗，請重新整理頁面後再試。');
        return;
      }
      updateContactCount();
    }

    /** @param {'academic'|'employer'} type */
    function addContact(type) {
      const list = getList(type);
      if (list.length >= MAX_CONTACTS) return;
      list.push(emptyContact(type));
      renderAllCards();
      saveState();
      showError('');
      const container = type === 'academic' ? $('#academic-contacts-container') : $('#employer-contacts-container');
      const lastCard = container?.lastElementChild;
      lastCard?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function showError(err) {
      const el = $('#form-error');
      const msg = typeof err === 'string' ? err : err?.message;
      if (!msg) {
        el.classList.add('hidden');
        el.textContent = '';
        clearFieldFlash();
        return;
      }
      el.textContent = msg;
      el.classList.remove('hidden');
      if (err && typeof err === 'object') focusInvalidField(err);
      else el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function clearFieldFlash() {
      $$('.field-flash, .section-flash').forEach((el) => {
        el.classList.remove('field-flash', 'section-flash');
      });
    }

    /** @param {{ message: string, globalId?: string, contactId?: string, field?: string, section?: string }} err */
    function focusInvalidField(err) {
      clearFieldFlash();
      let target = null;

      if (err.globalId) {
        target = document.getElementById(err.globalId);
      } else if (err.contactId && err.field) {
        const card = document.querySelector(`[data-contact-id="${err.contactId}"]`);
        if (card) {
          target = card.querySelector(err.field);
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } else if (err.section === 'academic') {
        target = $('#section-academic');
        target?.classList.add('section-flash');
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      } else if (err.section === 'employer') {
        target = $('#section-employer');
        target?.classList.add('section-flash');
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      if (!target) return;

      if (target.classList.contains('hidden')) target.classList.remove('hidden');

      target.classList.add('field-flash');
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (typeof target.focus === 'function') {
        try {
          target.focus({ preventScroll: true });
        } catch {
          target.focus();
        }
      }

      const removeFlash = () => {
        target.classList.remove('field-flash');
        target.removeEventListener('input', removeFlash);
        target.removeEventListener('change', removeFlash);
      };
      target.addEventListener('input', removeFlash, { once: true });
      target.addEventListener('change', removeFlash, { once: true });
    }

    /** @param {string} message @param {{ contactId?: string, field?: string, globalId?: string, section?: string }} [loc] */
    function validationErr(message, loc = {}) {
      return { message, ...loc };
    }

    function validateEmail(email) {
      const e = normalizeEmail(email);
      if (!e) return 'Email 為必填';
      if (EMAIL_FORBIDDEN.test(e)) return 'Email 含有不允許的字元';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)) return 'Email 格式不正確';
      return null;
    }

    /** @param {typeof academicContacts} list @param {'academic'|'employer'} type */
    function validateContactList(list, type) {
      const label = type === 'academic' ? '學術聯絡人' : '雇主聯絡人';
      for (let i = 0; i < list.length; i++) {
        const c = list[i];
        const n = i + 1;
        const loc = (field) => ({ contactId: c.id, field });
        if (!trimVal(c.title)) return validationErr(`${label} #${n}：請選擇 Title。`, loc('.field-title'));
        if (c.title === 'Other' && !trimVal(c.titleOther)) {
          return validationErr(`${label} #${n}：請填寫其他稱謂。`, loc('.field-title-other'));
        }
        if (!trimVal(c.firstName)) return validationErr(`${label} #${n}：請填寫 First Name。`, loc('.field-first-name'));
        if (!trimVal(c.lastName)) return validationErr(`${label} #${n}：請填寫 Last Name。`, loc('.field-last-name'));
        if (!trimVal(c.jobTitle)) {
          return validationErr(`${label} #${n}：請選擇 ${type === 'academic' ? 'Job Title' : 'Position'}。`, loc('.field-job-title'));
        }
        if (c.jobTitle === 'Other' && !trimVal(c.jobOther)) {
          return validationErr(`${label} #${n}：請填寫其他職稱說明。`, loc('.field-job-other'));
        }
        if (type === 'academic') {
          if (!trimVal(c.department)) return validationErr(`${label} #${n}：請填寫 Department。`, loc('.field-department'));
          if (!trimVal(c.subject)) return validationErr(`${label} #${n}：請選擇 Subject。`, loc('.field-subject'));
          if (c.subject === 'Other' && !trimVal(c.subjectOther)) {
            return validationErr(`${label} #${n}：請填寫其他學術領域說明。`, loc('.field-subject-other'));
          }
        } else {
          if (!trimVal(c.industry)) return validationErr(`${label} #${n}：請選擇 Industry。`, loc('.field-industry'));
          if (c.industry === 'Other' && !trimVal(c.industryOther)) {
            return validationErr(`${label} #${n}：請填寫其他產業說明。`, loc('.field-industry-other'));
          }
        }
        if (!trimVal(c.institution)) {
          return validationErr(
            `${label} #${n}：請填寫 ${type === 'academic' ? 'Institution' : 'Company Name'}。`,
            loc('.field-institution'),
          );
        }
        if (!trimVal(c.country)) return validationErr(`${label} #${n}：請選擇 Country or Territory。`, loc('.field-country'));
        if (c.country === 'Other' && !trimVal(c.countryOther)) {
          return validationErr(`${label} #${n}：請填寫其他國家／地區。`, loc('.field-country-other'));
        }
        const emailErr = validateEmail(c.email);
        if (emailErr) return validationErr(`${label} #${n}：${emailErr}。`, loc('.field-email'));
      }
      return null;
    }

    function validateAll() {
      const unit = trimVal($('#submitter-unit').value);
      const submitter = trimVal($('#submitter-name').value);
      if (!unit) return validationErr('請填寫提交單位。', { globalId: 'submitter-unit' });
      if (!submitter) return validationErr('請填寫提交人姓名。', { globalId: 'submitter-name' });
      if (!academicContacts.length && !employerContacts.length) {
        return validationErr('請至少新增一筆學術或雇主聯絡人。', { section: 'academic' });
      }
      return validateContactList(academicContacts, 'academic') || validateContactList(employerContacts, 'employer');
    }

    /** @param {'en'|'zh'} lang */
    function toAcademicExcelRow(c, lang = 'en') {
      return [
        lang === 'zh' ? SOURCE_ZH : SOURCE_EN,
        resolveTitle(c, lang),
        collapseSpaces(c.firstName),
        collapseSpaces(c.lastName),
        resolveJobTitle(c, lang),
        collapseSpaces(c.department),
        collapseSpaces(c.institution),
        resolveCountry(c, lang),
        normalizeEmail(c.email),
        resolveSubject(c, lang),
        normalizePhone(c.phone),
      ];
    }

    /** @param {'en'|'zh'} lang */
    function toEmployerExcelRow(c, lang = 'en') {
      return [
        lang === 'zh' ? SOURCE_ZH : SOURCE_EN,
        resolveTitle(c, lang),
        collapseSpaces(c.firstName),
        collapseSpaces(c.lastName),
        resolveJobTitle(c, lang),
        resolveDeptIndustry(c, lang),
        collapseSpaces(c.institution),
        resolveCountry(c, lang),
        normalizeEmail(c.email),
        normalizePhone(c.phone),
      ];
    }

    function buildPreviewCard(c, index, type) {
      const jobList = type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES;
      const typeLabel = type === 'academic' ? '學術' : '雇主';
      const titleText =
        c.title === 'Other'
          ? formatSimpleOther(c.titleOther, 'zh') + ' / ' + formatSimpleOther(c.titleOther, 'en')
          : displayOpt(TITLES, c.title);
      const jobText =
        c.jobTitle === 'Other'
          ? formatOther(c.jobOther, 'zh') + ' / ' + formatOther(c.jobOther, 'en')
          : displayOpt(jobList, c.jobTitle);
      const deptText =
        type === 'academic'
          ? trimVal(c.department)
          : c.industry === 'Other'
            ? formatIndustryOther(c.industryOther, 'zh') + ' / ' + formatIndustryOther(c.industryOther, 'en')
            : displayOpt(INDUSTRIES, c.industry);
      const countryText =
        c.country === 'Other'
          ? formatSimpleOther(c.countryOther, 'zh') + ' / ' + formatSimpleOther(c.countryOther, 'en')
          : displayOpt(COUNTRIES, c.country);
      const subjectText =
        type === 'academic'
          ? c.subject === 'Other'
            ? formatOther(c.subjectOther, 'zh') + ' / ' + formatOther(c.subjectOther, 'en')
            : displayOpt(SUBJECTS, c.subject)
          : '—';

      const fields = [
        ['Title', titleText],
        ['First Name', trimVal(c.firstName)],
        ['Last Name', trimVal(c.lastName)],
        [type === 'academic' ? 'Job Title' : 'Position', jobText],
        [type === 'academic' ? 'Department' : 'Industry', deptText],
        [type === 'academic' ? 'Institution' : 'Company Name', trimVal(c.institution)],
        ['Country or Territory', countryText],
        ['Email', trimVal(c.email)],
        ...(type === 'academic' ? [['Subject', subjectText]] : []),
        ['Phone (Optional)', trimVal(c.phone) || '—'],
      ];

      const card = document.createElement('article');
      card.className =
        type === 'academic'
          ? 'rounded-xl border border-fgu/20 bg-fgu-light/50 p-4 shadow-sm'
          : 'rounded-xl border border-qs/30 bg-qs-light/50 p-4 shadow-sm';
      const badge =
        type === 'academic'
          ? '<span class="inline-flex rounded-full bg-fgu/10 px-2.5 py-0.5 text-xs font-semibold text-fgu">學術 Academic</span>'
          : '<span class="inline-flex rounded-full bg-qs/15 px-2.5 py-0.5 text-xs font-semibold text-amber-900">雇主 Employer</span>';

      card.innerHTML = `
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-2">
          <h3 class="text-sm font-semibold text-slate-900">${typeLabel}聯絡人 #${index + 1}</h3>
          ${badge}
        </div>
        <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
          ${fields
            .map(
              ([label, value]) => `
            <div class="min-w-0">
              <dt class="text-xs font-medium text-slate-500">${label}</dt>
              <dd class="mt-0.5 break-words text-sm text-slate-800">${escapeHtml(value)}</dd>
            </div>`,
            )
            .join('')}
        </dl>
      `;
      return card;
    }

    function renderPreview() {
      const unit = trimVal($('#submitter-unit').value);
      const submitter = trimVal($('#submitter-name').value);
      $('#preview-meta').textContent = `提交單位：${unit}　｜　提交人姓名：${submitter}　｜　學術 ${academicContacts.length} 筆、雇主 ${employerContacts.length} 筆（資料已正規化；Excel 均含中文／English 分頁）`;

      const list = $('#preview-list');
      list.innerHTML = '';

      if (academicContacts.length) {
        const heading = document.createElement('h3');
        heading.className = 'text-base font-semibold text-fgu';
        heading.textContent = `學術聯絡人 (${academicContacts.length} 筆)`;
        list.appendChild(heading);
        const group = document.createElement('div');
        group.className = 'mb-6 space-y-4';
        academicContacts.forEach((c, i) => group.appendChild(buildPreviewCard(c, i, 'academic')));
        list.appendChild(group);
      }

      if (employerContacts.length) {
        const heading = document.createElement('h3');
        heading.className = 'text-base font-semibold text-amber-900';
        heading.textContent = `雇主聯絡人 (${employerContacts.length} 筆)`;
        list.appendChild(heading);
        const group = document.createElement('div');
        group.className = 'space-y-4';
        employerContacts.forEach((c, i) => group.appendChild(buildPreviewCard(c, i, 'employer')));
        list.appendChild(group);
      }

      $('#confirm-unlock').value = '';
      $('#btn-submit').disabled = true;
    }

    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function safeFilePart(name) {
      return trimVal(name).replace(/[\\/:*?"<>|]/g, '_').slice(0, 80) || '未命名單位';
    }

    function fileTimestamp() {
      const d = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
    }

    /** @type {string[]} */
    let downloadedFiles = [];
    /** @type {{ filename: string, blob: Blob }[]} */
    let downloadArtifacts = [];

    function renderDownloadPanel() {
      const panel = $('#download-panel');
      const btns = $('#download-buttons');
      btns.innerHTML = '';
      if (!downloadArtifacts.length) {
        panel.classList.add('hidden');
        return;
      }
      panel.classList.remove('hidden');

      downloadArtifacts.forEach(({ filename, blob }) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-primary text-sm';
        btn.textContent = `⬇ ${filename}`;
        btn.addEventListener('click', () => downloadBlob(blob, filename));
        btns.appendChild(btn);
      });

      if (downloadArtifacts.length > 1) {
        const allBtn = document.createElement('button');
        allBtn.type = 'button';
        allBtn.className = 'btn-secondary text-sm';
        allBtn.textContent = `⬇ 一次下載全部（${downloadArtifacts.length} 個檔案）`;
        allBtn.addEventListener('click', () => downloadBlobsSequential(downloadArtifacts));
        btns.appendChild(allBtn);
      }
    }

    async function handleSubmit() {
      normalizeAllData();
      const unit = safeFilePart($('#submitter-unit').value);
      const ts = fileTimestamp();
      downloadedFiles = [];
      downloadArtifacts = [];

      try {
        const queue = [];

        if (academicContacts.length) {
          const name = `QS_學術聯絡人名單_${unit}_${ts}.xlsx`;
          const blob = await createAcademicWorkbookBlob({
            headersZh: ACADEMIC_EXCEL_HEADERS_ZH,
            headersEn: ACADEMIC_EXCEL_HEADERS_EN,
            rowsZh: academicContacts.map((c) => toAcademicExcelRow(c, 'zh')),
            rowsEn: academicContacts.map((c) => toAcademicExcelRow(c, 'en')),
          });
          queue.push({ filename: name, blob });
        }

        if (employerContacts.length) {
          const name = `QS_雇主聯絡人名單_${unit}_${ts}.xlsx`;
          const blob = await createEmployerWorkbookBlob({
            headersZh: EMPLOYER_EXCEL_HEADERS_ZH,
            headersEn: EMPLOYER_EXCEL_HEADERS_EN,
            rowsZh: employerContacts.map((c) => toEmployerExcelRow(c, 'zh')),
            rowsEn: employerContacts.map((c) => toEmployerExcelRow(c, 'en')),
          });
          queue.push({ filename: name, blob });
        }

        downloadArtifacts = queue;
        downloadedFiles = queue.map((item) => item.filename);
        goToStep3();
      } catch (err) {
        console.error(err);
        alert('匯出 Excel 時發生錯誤，請再試一次。');
      }
    }

    function buildMailSubject(unit, submitter) {
      return `【QS聯絡人提報】${unit}－${submitter}`;
    }

    function buildMailBody(unit, submitter, summary, fileLines, academicCount, employerCount) {
      const attachmentNote =
        academicCount && employerCount
          ? '（含學術與雇主聯絡人名單；兩檔均含「中文」「English」「合併說明」分頁）'
          : academicCount
            ? '（學術聯絡人名單含「中文」「English」「合併說明」分頁）'
            : employerCount
              ? '（雇主聯絡人名單含「中文」「English」「合併說明」分頁）'
              : '';

      return `奕廷、嘉玲 您好：

謹此提報本單位 QS 世界大學排名學術／雇主問卷聯絡人名單，請查收協助後續作業，謝謝。

■ 提交單位：${unit}
■ 提交人姓名：${submitter}
■ 提交內容：${summary}
■ 附件檔案${attachmentNote}：
${fileLines}

敬祝
教安

${submitter}
${unit}
佛光大學`;
    }

    function goToStep3() {
      const unit = trimVal($('#submitter-unit').value);
      const submitter = trimVal($('#submitter-name').value);
      const academicCount = academicContacts.length;
      const employerCount = employerContacts.length;

      $('#copy-subject').textContent = buildMailSubject(unit, submitter);

      const fileLines = downloadedFiles.length
        ? downloadedFiles.map((f, i) => `${i + 1}. ${f}`).join('\n')
        : '（請確認已下載 Excel 檔案）';

      const summaryParts = [];
      if (academicCount) summaryParts.push(`學術聯絡人 ${academicCount} 筆`);
      if (employerCount) summaryParts.push(`雇主聯絡人 ${employerCount} 筆`);
      const summary = summaryParts.join('、') || '—';

      $('#copy-body').textContent = buildMailBody(
        unit,
        submitter,
        summary,
        fileLines,
        academicCount,
        employerCount,
      );

      const attachList = $('#attachment-list');
      attachList.innerHTML = '';
      if (downloadedFiles.length) {
        downloadedFiles.forEach((f) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2';
          li.innerHTML = `<span class="text-qs">📎</span><span>${escapeHtml(f)}</span>`;
          attachList.appendChild(li);
        });
      } else {
        attachList.innerHTML = '<li class="text-slate-500">（請先下載上方 Excel 檔案）</li>';
      }

      renderDownloadPanel();
      showStep(3);
    }

    function bindGlobal() {
      $('#submitter-unit').addEventListener('input', saveState);
      $('#submitter-name').addEventListener('input', saveState);

      $('#btn-add-academic').addEventListener('click', () => addContact('academic'));

      $('#btn-add-employer').addEventListener('click', () => addContact('employer'));

      $('#btn-preview').addEventListener('click', () => {
        normalizeAllData();
        const err = validateAll();
        if (err) {
          showError(err);
          return;
        }
        showError('');
        renderPreview();
        showStep(2);
      });

      $('#btn-back').addEventListener('click', () => showStep(1));

      $('#confirm-unlock').addEventListener('input', (e) => {
        $('#btn-submit').disabled = e.target.value.trim() !== UNLOCK_PHRASE;
      });

      $('#btn-submit').addEventListener('click', () => {
        if ($('#confirm-unlock').value.trim() !== UNLOCK_PHRASE) return;
        handleSubmit();
      });

      $$('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-copy-target');
          const text = $(`#${id}`).textContent;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          const original = btn.textContent;
          btn.textContent = '已複製！';
          setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        });
      });

      $('#btn-reset').addEventListener('click', () => {
        localStorage.removeItem(STORAGE_KEY);
        location.reload();
      });
    }

    function init() {
      bindGlobal();
      const saved = loadState();
      if (saved && (saved.academicContacts?.length || saved.employerContacts?.length)) {
        $('#submitter-unit').value = saved.unit || '';
        $('#submitter-name').value = saved.submitter || '';
        academicContacts = (saved.academicContacts || []).map((c) => ({
          ...emptyContact('academic'),
          ...c,
          id: c.id || uid(),
          type: 'academic',
        }));
        employerContacts = (saved.employerContacts || []).map((c) => ({
          ...emptyContact('employer'),
          ...c,
          id: c.id || uid(),
          type: 'employer',
        }));
        renderAllCards();
        if (saved.step === 2) {
          const err = validateAll();
          if (!err) {
            renderPreview();
            showStep(2);
            return;
          }
        }
        showStep(1);
      } else {
        academicContacts = [];
        employerContacts = [];
        renderAllCards();
        showStep(1);
      }
    }

    init();
  </script>
</Layout>
