---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout>
  <div class="page-deco" aria-hidden="true"></div>
  <div class="page-content min-h-screen">
    <!-- Header -->
    <header class="site-header relative overflow-hidden border-b border-fgu/30 bg-gradient-to-br from-fgu via-fgu-dark to-fgu-deep text-white">
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-qs/15 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-10 h-48 w-48 rounded-full bg-sage/20 blur-2xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-1/4 top-1/2 h-32 w-32 -translate-y-1/2 rounded-full bg-warm-gold/10 blur-2xl" aria-hidden="true"></div>
      <div class="page-shell relative py-6 sm:py-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            <img
              src={`${base}images/fgu-logo.png`}
              alt="佛光大學校徽"
              class="header-logo-ring h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-white/30 sm:h-20 sm:w-20"
              width="80"
              height="80"
            />
            <div>
              <p class="text-sm font-medium text-white/80">Fo Guang University</p>
              <h1 class="mt-0.5 text-xl font-bold tracking-tight sm:text-2xl lg:text-3xl">
                QS 學術與雇主問卷聯絡人提交系統
              </h1>
            </div>
          </div>
          <div class="flex items-center gap-3 self-start sm:self-center">
            <span class="hidden text-xs font-medium uppercase tracking-wider text-white/60 sm:inline">Powered by</span>
            <img
              src={`${base}images/qs-logo.png`}
              alt="QS Logo"
              class="h-12 w-12 shrink-0 rounded-lg shadow-md ring-2 ring-white/20 sm:h-14 sm:w-14"
              width="56"
              height="56"
            />
          </div>
        </div>
        <p class="mt-5 max-w-3xl text-sm leading-relaxed text-white/85 sm:text-base">
          依 QS Global Academic and Employer Survey Guidelines 填寫聯絡人資料。
        </p>
        <div class="guidelines-box mt-4 rounded-xl border border-white/20 px-4 py-3 backdrop-blur-sm">
          <p class="text-sm font-semibold text-white">QS Global Academic and Employer Survey Guidelines</p>
          <div class="mt-2 flex flex-wrap gap-2">
            <a
              href={`${base}docs/qs-guidelines-en.pdf`}
              target="_blank"
              rel="noopener noreferrer"
              class="guidelines-link inline-flex items-center gap-1.5 rounded-lg border border-white/25 bg-white/15 px-3 py-1.5 text-sm font-medium text-white"
            >
              <span aria-hidden="true">📄</span>
              English（PDF 預覽）
            </a>
            <a
              href={`${base}docs/qs-guidelines-zh.pdf`}
              target="_blank"
              rel="noopener noreferrer"
              class="guidelines-link inline-flex items-center gap-1.5 rounded-lg border border-white/25 bg-white/15 px-3 py-1.5 text-sm font-medium text-white"
            >
              <span aria-hidden="true">📄</span>
              中文譯本（PDF 預覽）
            </a>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-2" aria-hidden="true">
          <div class="header-accent-line h-1 w-20 rounded-full shadow-sm"></div>
          <div class="h-1.5 w-1.5 rounded-full bg-sage-light/80"></div>
          <div class="h-1 w-8 rounded-full bg-white/30"></div>
        </div>
      </div>
    </header>

    <main class="page-shell py-6 sm:py-8">
      <!-- Step indicator -->
      <nav aria-label="進度" class="step-nav card-panel mb-8">
        <ol class="flex flex-wrap items-center justify-center gap-3 text-sm sm:gap-6">
          <li id="step-indicator-1" class="step-item step-item--active flex items-center gap-2">
            <span class="step-badge">1</span>
            <span class="step-label">填寫</span>
          </li>
          <li class="step-connector hidden h-px w-10 sm:block" aria-hidden="true"></li>
          <li id="step-indicator-2" class="step-item step-item--pending flex items-center gap-2">
            <span class="step-badge">2</span>
            <span class="step-label">預覽與提交</span>
          </li>
          <li class="step-connector hidden h-px w-10 sm:block" aria-hidden="true"></li>
          <li id="step-indicator-3" class="step-item step-item--pending flex items-center gap-2">
            <span class="step-badge">3</span>
            <span class="step-label">完成</span>
          </li>
        </ol>
      </nav>

      <!-- ========== STEP 1 ========== -->
      <section id="step-1" class="space-y-6">
        <p class="info-banner">
          學術聯絡人與雇主聯絡人各最多 100 筆。
          可先
          <a
            href={`${import.meta.env.BASE_URL}templates/QS_聯絡人匯入樣板.xlsx`}
            class="font-semibold text-fgu underline decoration-fgu/40 underline-offset-2 hover:text-fgu-dark"
            download
          >
            下載匯入樣板（Excel）
          </a>
          離線整理後，可
          <strong>上傳 Excel 匯入</strong>
          （會先驗證再匯入），或於下方手動新增聯絡人。
        </p>

        <details class="details-panel">
          <summary>Email 填寫說明（依 QS 方法論 §2.8）</summary>
          <ul class="mt-3 space-y-2 text-xs leading-relaxed text-slate-600">
            <li>• 請填寫聯絡人<strong>個人信箱或個人公務信箱</strong>，避免使用 team@、info@、admissions@ 等共用或團隊信箱。</li>
            <li>• 每位聯絡人僅填<strong>一組</strong> email。</li>
            <li>• 不同聯絡人請使用<strong>不同信箱</strong>；多人共用同一信箱時，QS 僅會寄送一次問卷邀請。</li>
            <li>• 不可含空白，亦不可含 <code class="rounded bg-white px-1">[ ] { } ( ) ; : , &lt; &gt; ' # ~ = +</code> 等符號。</li>
          </ul>
        </details>

        <div class="sticky-panel card-panel sticky top-0 z-20 space-y-4 supports-[backdrop-filter]:bg-white/95">
          <h2 class="panel-title">
            <span class="panel-title-mark" aria-hidden="true"></span>
            提交資訊
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="submitter-unit" class="mb-1.5 block text-sm font-medium text-slate-700">
                提交單位 (Department / Unit) <span class="text-red-500">*</span>
              </label>
              <input id="submitter-unit" type="text" required placeholder="例如：歷史學系、永續辦公室、國際處..." class="input-field" />
            </div>
            <div>
              <label for="submitter-name" class="mb-1.5 block text-sm font-medium text-slate-700">
                提交人姓名 (Submitter Name) <span class="text-red-500">*</span>
              </label>
              <input id="submitter-name" type="text" required placeholder="請輸入您的姓名" class="input-field" />
            </div>
          </div>
        </div>

        <div class="card-panel space-y-4" id="import-panel">
          <h2 class="panel-title">
            <span class="panel-title-mark" aria-hidden="true"></span>
            從 Excel 匯入
          </h2>
          <p class="text-sm text-slate-600">
            請使用
            <a
              href={`${import.meta.env.BASE_URL}templates/QS_聯絡人匯入樣板.xlsx`}
              class="font-semibold text-fgu underline decoration-fgu/40 underline-offset-2 hover:text-fgu-dark"
              download
            >
              匯入樣板
            </a>
            。上傳後會先檢查欄位、選項、Email 等，<strong>全部通過</strong>即覆蓋並進入預覽頁；若表單已有聯絡人資料會先詢問是否覆蓋。選項欄位有下拉提示，也可直接輸入；選單外文字會自動視為 Other。
          </p>
          <div class="import-zone" id="import-zone">
            <p class="text-sm text-slate-600">拖曳 .xlsx 到這裡，或</p>
            <label class="mt-3 inline-block cursor-pointer">
              <span class="btn-secondary">選擇 Excel 檔案</span>
              <input
                id="import-file"
                type="file"
                accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                class="hidden"
              />
            </label>
            <p id="import-file-name" class="mt-3 text-sm font-medium text-fgu-dark"></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="btn-parse-import" class="btn-primary" disabled>解析並驗證</button>
            <button type="button" id="btn-clear-import" class="btn-secondary hidden">清除</button>
          </div>

          <div id="import-progress" class="import-progress hidden" role="status" aria-live="polite" aria-busy="false">
            <div class="import-progress__meta">
              <span class="import-progress__label">
                <span id="import-progress-label">處理中</span>
                <span class="import-progress__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              </span>
              <span id="import-progress-percent">0%</span>
            </div>
            <div class="import-progress__track" aria-hidden="true">
              <div id="import-progress-bar" class="import-progress__bar"></div>
            </div>
          </div>

          <div id="import-result" class="hidden space-y-4 border-t border-slate-200 pt-4">
            <p id="import-summary" class="text-sm font-medium text-slate-800"></p>
            <div id="import-errors-wrap" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3">
              <p class="text-sm font-semibold text-red-800">請修正以下問題後再匯入：</p>
              <ul id="import-errors" class="mt-2 space-y-1 text-sm text-red-700"></ul>
            </div>
          </div>
        </div>

        <!-- 學術聯絡人 -->
        <section id="section-academic" class="section-academic">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-start gap-3">
              <span class="section-icon section-icon--academic" aria-hidden="true">A</span>
              <div>
                <h2 class="text-lg font-semibold text-fgu-dark">學術聯絡人 (Academic)</h2>
              </div>
            </div>
            <span id="academic-count" class="count-badge count-badge--academic">(0 / 100)</span>
          </div>
          <div id="academic-contacts-container" class="space-y-5"></div>
          <p id="academic-empty-hint" class="hidden rounded-xl border border-dashed border-fgu/30 bg-white/70 px-4 py-8 text-center text-sm text-slate-500">
            尚未新增學術聯絡人，請點下方按鈕新增。
          </p>
          <div class="mt-4 flex justify-end">
            <button type="button" id="btn-add-academic" class="btn-primary">
              <span aria-hidden="true">＋</span> 新增學術聯絡人
            </button>
          </div>
        </section>

        <!-- 雇主聯絡人 -->
        <section id="section-employer" class="section-employer">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-start gap-3">
              <span class="section-icon section-icon--employer" aria-hidden="true">E</span>
              <div>
                <h2 class="text-lg font-semibold text-amber-900">雇主聯絡人 (Employer)</h2>
              </div>
            </div>
            <span id="employer-count" class="count-badge count-badge--employer">(0 / 100)</span>
          </div>
          <div id="employer-contacts-container" class="space-y-5"></div>
          <p id="employer-empty-hint" class="hidden rounded-xl border border-dashed border-qs/40 bg-white/70 px-4 py-8 text-center text-sm text-slate-500">
            尚未新增雇主聯絡人，請點下方按鈕新增。
          </p>
          <div class="mt-4 flex justify-end">
            <button type="button" id="btn-add-employer" class="btn-qs">
              <span aria-hidden="true">＋</span> 新增雇主聯絡人
            </button>
          </div>
        </section>

        <p id="form-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 shadow-sm" role="alert"></p>

        <div class="action-bar">
          <button type="button" id="btn-open-clear" class="btn-secondary px-5 py-2.5">
            清空所有欄位
          </button>
          <button type="button" id="btn-preview" class="btn-primary px-6 py-3 text-base">
            預覽與確認名單 →
          </button>
        </div>
      </section>

      <!-- ========== STEP 2 ========== -->
      <section id="step-2" class="hidden space-y-6">
        <div class="card-panel shadow-md">
          <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-slate-900">確認提報名單</h2>
            <button type="button" id="btn-back" class="btn-secondary">← 返回修改</button>
          </div>
          <p id="preview-meta" class="preview-meta-bar"></p>
          <div id="preview-list" class="space-y-4"></div>
        </div>

        <div class="unlock-panel">
          <label for="confirm-unlock" class="mb-2 block text-sm font-medium text-fgu-dark">
            防呆解鎖：請輸入「我確定提交」以解鎖提交按鈕
          </label>
          <input id="confirm-unlock" type="text" autocomplete="off" placeholder="我確定提交" class="input-field max-w-md" />
          <div class="mt-4">
            <button type="button" id="btn-submit" disabled class="btn-qs px-6 disabled:bg-slate-300 disabled:text-slate-500">
              確認提交
            </button>
            <p id="submit-hint" class="mt-2 text-xs leading-relaxed text-slate-500">
              可複製上方「我確定提交」以完成提交。
            </p>
          </div>
          <div id="submit-progress" class="import-progress mt-4 hidden" role="status" aria-live="polite" aria-busy="false">
            <div class="import-progress__meta">
              <span class="import-progress__label">
                <span id="submit-progress-label">提交中</span>
                <span class="import-progress__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              </span>
              <span id="submit-progress-percent">0%</span>
            </div>
            <div class="import-progress__track" aria-hidden="true">
              <div id="submit-progress-bar" class="import-progress__bar"></div>
            </div>
            <p id="submit-progress-footnote" class="import-progress__footnote hidden" role="note"></p>
          </div>
        </div>
      </section>

      <!-- ========== STEP 3 ========== -->
      <section id="step-3" class="hidden space-y-6">
        <div class="success-hero card-panel shadow-md">
          <div class="success-icon" aria-hidden="true">✓</div>
          <h2 id="success-title" class="text-xl font-bold text-fgu-dark">已提交成功</h2>
          <p id="success-desc" class="mt-2 text-sm text-slate-600">
            下方 Excel 可下載備份。
          </p>
          <p id="submission-id-line" class="mt-3 hidden text-xs text-slate-500"></p>
        </div>

        <div class="card-panel shadow-md">
          <h3 class="panel-title">
            <span class="panel-title-mark" aria-hidden="true"></span>
            下載 Excel 備份
          </h3>
          <div id="download-panel" class="download-panel mt-3 hidden">
            <div id="download-buttons" class="flex flex-wrap gap-2"></div>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-3">
          <button type="button" id="btn-back-to-form" class="btn-primary px-6 py-2.5 font-semibold">
            回到原填寫內容
          </button>
          <button type="button" id="btn-reset" class="btn-secondary px-6 py-2.5 font-semibold">
            重新填寫一份新表單
          </button>
        </div>
      </section>
    </main>

    <!-- 清空所有欄位確認 -->
    <div id="clear-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="clear-modal-title">
      <div id="clear-modal-backdrop" class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm"></div>
      <div class="relative flex min-h-full items-center justify-center p-4">
        <div class="modal-panel card-panel w-full max-w-md shadow-xl">
          <h3 id="clear-modal-title" class="text-lg font-semibold text-slate-900">確認清空所有欄位</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            此操作將清除目前填寫的所有資料（含已儲存於本機的草稿），且無法復原。
          </p>
          <label for="clear-confirm" class="mt-4 block text-sm font-medium text-fgu-dark">
            防呆確認：請輸入「我確定要清空以上資料」
          </label>
          <input id="clear-confirm" type="text" autocomplete="off" placeholder="我確定要清空以上資料" class="input-field mt-2" />
          <div class="mt-5 flex justify-end gap-2">
            <button type="button" id="btn-clear-cancel" class="btn-secondary px-4 py-2">取消</button>
            <button type="button" id="btn-clear-confirm" disabled class="btn-danger">
              清空所有欄位
            </button>
          </div>
        </div>
      </div>
    </div>

    <footer class="site-footer relative mt-8 border-t border-fgu/10 bg-white/90 py-8 backdrop-blur-sm">
      <div class="footer-bar absolute inset-x-0 top-0 h-1" aria-hidden="true"></div>
      <div class="page-shell flex flex-col items-center gap-4 pt-2 sm:flex-row sm:justify-between">
        <div class="flex items-center gap-3">
          <img src={`${base}images/fgu-logo.png`} alt="" class="h-10 w-10 rounded-full object-cover" width="40" height="40" aria-hidden="true" />
          <p class="text-xs text-slate-500">Fo Guang University · QS Contact Submission</p>
        </div>
        <img src={`${base}images/qs-logo.png`} alt="QS" class="h-8 w-8 rounded opacity-80" width="32" height="32" />
      </div>
    </footer>
  </div>

  <!-- Option datalists (combobox suggestions) -->
  <datalist id="datalist-titles"></datalist>
  <datalist id="datalist-academic-jobs"></datalist>
  <datalist id="datalist-employer-jobs"></datalist>
  <datalist id="datalist-industries"></datalist>
  <datalist id="datalist-countries"></datalist>
  <datalist id="datalist-subjects"></datalist>

  <!-- Contact card template -->
  <template id="contact-card-template">
    <article class="contact-card border-slate-200" data-contact-id="">
      <div class="mb-4 flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-3">
        <h3 class="contact-card-title text-base font-semibold text-slate-900">聯絡人 #1</h3>
        <button type="button" class="btn-remove btn-remove-contact">
          刪除
        </button>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 [&>div]:min-w-0">
        <!-- Title -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Title <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            class="field-title input-field combobox-field"
            list="datalist-titles"
            required
            placeholder="請選擇或輸入"
            autocomplete="off"
          />
          <p class="mt-1 text-xs text-slate-500">可從下拉選擇，或直接輸入；選單外會自動視為 Other</p>
        </div>

        <!-- First Name -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            First Name <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-first-name input-field" required placeholder="名字（不含空白前後）" />
        </div>

        <!-- Last Name -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Last Name <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-last-name input-field" required placeholder="姓氏（不含空白前後）" />
        </div>

        <!-- Job Title / Position -->
        <div>
          <label class="label-job-title mb-1.5 block text-sm font-medium text-slate-700">
            Job Title <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            class="field-job-title input-field combobox-field"
            list="datalist-academic-jobs"
            required
            placeholder="請選擇或輸入"
            autocomplete="off"
          />
          <p class="mt-1 text-xs text-slate-500">可從下拉選擇，或直接輸入；選單外會自動視為 Other</p>
        </div>

        <!-- Department / Industry -->
        <div>
          <label class="label-dept-industry mb-1.5 block text-sm font-medium text-slate-700">
            Department <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-department input-field" placeholder="請填寫完整系所名稱" />
          <input
            type="text"
            class="field-industry input-field combobox-field hidden"
            list="datalist-industries"
            placeholder="請選擇或輸入產業"
            autocomplete="off"
          />
          <p class="field-industry-hint mt-1 hidden text-xs text-slate-500">可從下拉選擇，或直接輸入；選單外會自動視為 Other</p>
        </div>

        <!-- Institution / Company Name -->
        <div>
          <label class="label-institution mb-1.5 block text-sm font-medium text-slate-700">
            Institution <span class="text-red-500">*</span>
          </label>
          <input type="text" class="field-institution input-field" required placeholder="機構正式名稱" />
        </div>

        <!-- Country -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Country or Territory <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            class="field-country input-field combobox-field"
            list="datalist-countries"
            required
            placeholder="請選擇或輸入"
            autocomplete="off"
          />
          <p class="mt-1 text-xs text-slate-500">可從下拉選擇，或直接輸入；選單外會自動視為 Other</p>
        </div>

        <!-- Email -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Email <span class="text-red-500">*</span>
          </label>
          <input type="email" class="field-email input-field" required placeholder="例：name@univ.edu.tw（個人信箱或個人公務信箱）" />
          <p class="mt-1.5 text-xs leading-relaxed text-slate-500">
            依 QS §2.8：個人信箱或個人公務信箱、僅填一組、勿填共用信箱、勿與其他聯絡人重複。
          </p>
        </div>

        <!-- Subject (academic only) -->
        <div class="subject-wrap">
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Subject <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            class="field-subject input-field combobox-field"
            list="datalist-subjects"
            placeholder="請選擇或輸入學術領域"
            autocomplete="off"
          />
          <p class="mt-1 text-xs text-slate-500">可從下拉選擇，或直接輸入；選單外會自動視為 Other</p>
        </div>

        <!-- Phone -->
        <div>
          <label class="mb-1.5 block text-sm font-medium text-slate-700">
            Phone <span class="text-slate-400">(選填)</span>
          </label>
          <input type="tel" class="field-phone input-field" placeholder="含國際碼，例如 +886..." />
        </div>
      </div>
    </article>
  </template>

  <script>
    import {
      downloadBlobsSequential,
      downloadBlob,
      createAcademicWorkbookBlob,
      createEmployerWorkbookBlob,
    } from '../scripts/excel-export.js';
    import { parseImportFile } from '../scripts/excel-import.js';
    import { normalizeEmail as normalizeEmailImport, resolveFlexibleOption, displayOptionInput } from '../scripts/contact-validation.js';
    import {
      TITLES,
      ACADEMIC_JOB_TITLES,
      EMPLOYER_JOB_TITLES,
      INDUSTRIES,
      COUNTRIES,
      DEFAULT_COUNTRY,
      SUBJECTS,
      ACADEMIC_EXCEL_HEADERS_EN,
      ACADEMIC_EXCEL_HEADERS_ZH,
      EMPLOYER_EXCEL_HEADERS_EN,
      EMPLOYER_EXCEL_HEADERS_ZH,
      SOURCE_EN,
      SOURCE_ZH,
      bilingualLabel,
      optionText,
      findOption,
    } from '../data/qs-options.js';

    const STORAGE_KEY = 'qs-contact-form-v3';
    const MAX_CONTACTS = 100;
    const UNLOCK_PHRASE = '我確定提交';
    const CLEAR_PHRASE = '我確定要清空以上資料';
    const EMAIL_FORBIDDEN = /[\[\]{}();:,<>'#~=+"¬`!]/;
    /** 由 .env / 部署環境變數 PUBLIC_GOOGLE_SCRIPT_URL 注入；未設定時改以下載備份處理 */
    const GOOGLE_SCRIPT_URL = (import.meta.env.PUBLIC_GOOGLE_SCRIPT_URL || '').trim();

    /** @type {{ id: string, type: string, title: string, titleOther: string, firstName: string, lastName: string, jobTitle: string, jobOther: string, department: string, industry: string, industryOther: string, institution: string, country: string, countryOther: string, email: string, subject: string, subjectOther: string, phone: string }[]} */
    let academicContacts = [];
    /** @type {typeof academicContacts} */
    let employerContacts = [];
    let currentStep = 1;
    /** @type {'online'|'offline'|null} */
    let lastSubmitMode = null;
    let lastSubmissionId = '';
    let lastSubmitTimestamp = '';
    let lastSubmitError = '';
    /** @type {import('../scripts/excel-import.js').parseImportFile extends (f: any) => Promise<infer R> ? R | null : null} */
    let pendingImport = null;

    const $ = (sel, root = document) => root.querySelector(sel);
    const $$ = (sel, root = document) => [...root.querySelectorAll(sel)];

    function formatProgressLabel(text, fallback = '處理中') {
      return String(text || fallback).replace(/[.…⋯]+$/u, '').trim();
    }

    function uid() {
      return `c_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
    }

    /** @param {'academic'|'employer'} type */
    function emptyContact(type) {
      return {
        id: uid(),
        type,
        title: '',
        titleOther: '',
        firstName: '',
        lastName: '',
        jobTitle: '',
        jobOther: '',
        department: '',
        industry: '',
        industryOther: '',
        institution: '',
        country: DEFAULT_COUNTRY,
        countryOther: '',
        email: '',
        subject: '',
        subjectOther: '',
        phone: '',
      };
    }

    /** @param {'academic'|'employer'} type */
    function getList(type) {
      return type === 'academic' ? academicContacts : employerContacts;
    }

    /** @param {'academic'|'employer'} type */
    function setList(type, list) {
      if (type === 'academic') academicContacts = list;
      else employerContacts = list;
    }

    function findContact(id) {
      return academicContacts.find((c) => c.id === id) || employerContacts.find((c) => c.id === id) || null;
    }

    function fillDatalist(id, options) {
      const dl = document.getElementById(id);
      if (!dl) return;
      dl.innerHTML = '';
      for (const item of options) {
        const en = typeof item === 'string' ? item : item.en;
        const opt = document.createElement('option');
        opt.value = en;
        if (typeof item !== 'string') opt.label = bilingualLabel(item);
        dl.appendChild(opt);
      }
    }

    function populateAllDatalists() {
      fillDatalist('datalist-titles', TITLES);
      fillDatalist('datalist-academic-jobs', ACADEMIC_JOB_TITLES);
      fillDatalist('datalist-employer-jobs', EMPLOYER_JOB_TITLES);
      fillDatalist('datalist-industries', INDUSTRIES);
      fillDatalist('datalist-countries', COUNTRIES);
      fillDatalist('datalist-subjects', SUBJECTS);
    }

    function readComboboxField(input, list, { pluralOther = false } = {}) {
      const flex = resolveFlexibleOption(list, input?.value || '', { pluralOther });
      return { en: flex.en, other: flex.other };
    }

    function setComboboxField(input, list, en, other, { pluralOther = false } = {}) {
      if (!input) return;
      input.value = displayOptionInput(en, other, list);
    }

    function displayOpt(list, en) {
      const found = findOption(list, en);
      return found ? bilingualLabel(found) : trimVal(en);
    }

    function trimVal(v) {
      return String(v ?? '').trim();
    }

    /** 去除前後空白，並將連續空白合併為單一空格 */
    function collapseSpaces(v) {
      return trimVal(v).replace(/\s+/g, ' ');
    }

    /** QS §2.8：email 不含空白，統一小寫 */
    function normalizeEmail(v) {
      return trimVal(v).replace(/\s+/g, '').toLowerCase();
    }

    /** Phone 去除空白（保留 + 與數字等符號） */
    function normalizePhone(v) {
      return trimVal(v).replace(/\s+/g, '');
    }

    /** @param {typeof academicContacts[0]} c */
    function normalizeContact(c) {
      c.firstName = collapseSpaces(c.firstName);
      c.lastName = collapseSpaces(c.lastName);
      c.department = collapseSpaces(c.department);
      c.institution = collapseSpaces(c.institution);
      c.email = normalizeEmail(c.email);
      c.phone = normalizePhone(c.phone);
      c.titleOther = c.title === 'Other' ? collapseSpaces(c.titleOther) : '';
      c.jobOther = c.jobTitle === 'Other' ? collapseSpaces(c.jobOther) : '';
      c.industryOther = c.industry === 'Other' ? collapseSpaces(c.industryOther) : '';
      c.countryOther = c.country === 'Other' ? collapseSpaces(c.countryOther) : '';
      c.subjectOther = c.subject === 'Other' ? collapseSpaces(c.subjectOther) : '';
      return c;
    }

    function normalizeAllData() {
      $$('.contact-card').forEach(syncCardToModel);
      academicContacts.forEach(normalizeContact);
      employerContacts.forEach(normalizeContact);
      const unitEl = $('#submitter-unit');
      const nameEl = $('#submitter-name');
      if (unitEl) unitEl.value = collapseSpaces(unitEl.value);
      if (nameEl) nameEl.value = collapseSpaces(nameEl.value);
      renderAllCards();
      saveState();
    }

    /** QS §2：Title／Country／Industry → Other (x)；Job／Subject → Others (x) */
    function formatQsOtherValue(detail, lang = 'en', { plural = false } = {}) {
      const d = trimVal(detail);
      if (lang === 'zh') return d ? `其他 (${d})` : '其他';
      const label = plural ? 'Others' : 'Other';
      return d ? `${label} (${d})` : label;
    }

    function formatOther(otherText, lang = 'en') {
      return formatQsOtherValue(otherText, lang, { plural: true });
    }

    function formatIndustryOther(otherText, lang = 'en') {
      return formatQsOtherValue(otherText, lang, { plural: false });
    }

    function formatSimpleOther(otherText, lang = 'en') {
      return formatQsOtherValue(otherText, lang, { plural: false });
    }

    /** @param {'en'|'zh'} lang */
    function resolveJobTitle(c, lang = 'en') {
      const list = c.type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES;
      if (c.jobTitle === 'Other') return formatOther(c.jobOther, lang);
      return optionText(list, c.jobTitle, lang) || trimVal(c.jobTitle);
    }

    /** @param {'en'|'zh'} lang */
    function resolveDeptIndustry(c, lang = 'en') {
      if (c.type === 'academic') return trimVal(c.department);
      if (c.industry === 'Other') return formatIndustryOther(c.industryOther, lang);
      return optionText(INDUSTRIES, c.industry, lang) || trimVal(c.industry);
    }

    /** @param {'en'|'zh'} lang */
    function resolveSubject(c, lang = 'en') {
      if (c.type !== 'academic') return '';
      if (c.subject === 'Other') return formatOther(c.subjectOther, lang);
      return optionText(SUBJECTS, c.subject, lang) || trimVal(c.subject);
    }

    function formatVenTitle(lang = 'en') {
      return lang === 'zh' ? '其他(Ven)' : 'Other(Ven)';
    }

    /** @param {'en'|'zh'} lang */
    function resolveTitle(c, lang = 'en') {
      if (c.title === 'Other') return formatSimpleOther(c.titleOther, lang);
      if (c.title === 'Ven') return formatVenTitle(lang);
      return optionText(TITLES, c.title, lang) || trimVal(c.title);
    }

    /** @param {'en'|'zh'} lang */
    function resolveCountry(c, lang = 'en') {
      if (c.country === 'Other') return formatSimpleOther(c.countryOther, lang);
      return optionText(COUNTRIES, c.country, lang) || trimVal(c.country);
    }

    function saveState() {
      const state = {
        step: currentStep,
        unit: trimVal($('#submitter-unit')?.value),
        submitter: trimVal($('#submitter-name')?.value),
        academicContacts,
        employerContacts,
      };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {
        /* ignore quota */
      }
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        // migrate v2 single-list format
        if (parsed.contacts?.length && !parsed.academicContacts && !parsed.employerContacts) {
          parsed.academicContacts = parsed.contacts.filter((c) => c.type === 'academic');
          parsed.employerContacts = parsed.contacts.filter((c) => c.type === 'employer');
        }
        return parsed;
      } catch {
        return null;
      }
    }

    function updateContactCount() {
      $('#academic-count').textContent = `(${academicContacts.length} / ${MAX_CONTACTS})`;
      $('#employer-count').textContent = `(${employerContacts.length} / ${MAX_CONTACTS})`;
      $('#btn-add-academic').disabled = academicContacts.length >= MAX_CONTACTS;
      $('#btn-add-employer').disabled = employerContacts.length >= MAX_CONTACTS;
      $('#btn-add-academic').closest('div')?.classList.toggle('hidden', academicContacts.length >= MAX_CONTACTS);
      $('#btn-add-employer').closest('div')?.classList.toggle('hidden', employerContacts.length >= MAX_CONTACTS);
      $('#academic-empty-hint').classList.toggle('hidden', academicContacts.length > 0);
      $('#employer-empty-hint').classList.toggle('hidden', employerContacts.length > 0);
    }

    function setStepIndicators(step) {
      for (let i = 1; i <= 3; i++) {
        const el = $(`#step-indicator-${i}`);
        el.className = 'step-item flex items-center gap-2';
        el.classList.add(i === step ? 'step-item--active' : i < step ? 'step-item--done' : 'step-item--pending');
      }
    }

    function showStep(step) {
      currentStep = step;
      $('#step-1').classList.toggle('hidden', step !== 1);
      $('#step-2').classList.toggle('hidden', step !== 2);
      $('#step-3').classList.toggle('hidden', step !== 3);
      setStepIndicators(step);
      saveState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function applyTypeUI(card, type) {
      const label = $('.label-dept-industry', card);
      const labelJob = $('.label-job-title', card);
      const labelInst = $('.label-institution', card);
      const dept = $('.field-department', card);
      const industry = $('.field-industry', card);
      const industryHint = $('.field-industry-hint', card);
      const subjectWrap = $('.subject-wrap', card);
      const jobInput = $('.field-job-title', card);
      const instInput = $('.field-institution', card);

      jobInput.setAttribute('list', type === 'academic' ? 'datalist-academic-jobs' : 'datalist-employer-jobs');

      if (type === 'academic') {
        labelJob.innerHTML = 'Job Title <span class="text-red-500">*</span>';
        label.innerHTML = 'Department <span class="text-red-500">*</span>';
        labelInst.innerHTML = 'Institution <span class="text-red-500">*</span>';
        instInput.placeholder = '機構正式名稱（聯絡人所屬大學）';
        dept.classList.remove('hidden');
        dept.required = true;
        industry.classList.add('hidden');
        industry.required = false;
        industryHint?.classList.add('hidden');
        subjectWrap.classList.remove('hidden');
        $('.field-subject', card).required = true;
      } else {
        labelJob.innerHTML = 'Position <span class="text-red-500">*</span>';
        label.innerHTML = 'Industry <span class="text-red-500">*</span>';
        labelInst.innerHTML = 'Company Name <span class="text-red-500">*</span>';
        instInput.placeholder = '公司正式名稱';
        dept.classList.add('hidden');
        dept.required = false;
        industry.classList.remove('hidden');
        industry.required = true;
        industryHint?.classList.remove('hidden');
        subjectWrap.classList.add('hidden');
        $('.field-subject', card).required = false;
      }
    }

    function syncCardToModel(card) {
      const id = card.dataset.contactId;
      const type = card.dataset.contactType;
      const c = findContact(id);
      if (!c) return;

      const jobList = type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES;
      const titleFlex = readComboboxField($('.field-title', card), TITLES);
      const jobFlex = readComboboxField($('.field-job-title', card), jobList, { pluralOther: true });
      const industryFlex = readComboboxField($('.field-industry', card), INDUSTRIES);
      const countryFlex = readComboboxField($('.field-country', card), COUNTRIES);
      const subjectFlex = readComboboxField($('.field-subject', card), SUBJECTS, { pluralOther: true });

      c.type = type;
      c.title = titleFlex.en;
      c.titleOther = titleFlex.other;
      c.firstName = $('.field-first-name', card).value;
      c.lastName = $('.field-last-name', card).value;
      c.jobTitle = jobFlex.en;
      c.jobOther = jobFlex.other;
      c.department = $('.field-department', card).value;
      c.industry = industryFlex.en;
      c.industryOther = industryFlex.other;
      c.institution = $('.field-institution', card).value;
      c.country = countryFlex.en;
      c.countryOther = countryFlex.other;
      c.email = $('.field-email', card).value;
      c.subject = subjectFlex.en;
      c.subjectOther = subjectFlex.other;
      c.phone = $('.field-phone', card).value;
      saveState();
    }

    /** @param {'academic'|'employer'} type */
    function renderContactCard(contact, index, type) {
      const tpl = $('#contact-card-template');
      const node = tpl.content.firstElementChild.cloneNode(true);
      node.dataset.contactId = contact.id;
      node.dataset.contactType = type;
      node.classList.add(type === 'academic' ? 'academic-card' : 'employer-card');
      if (type === 'academic') {
        node.classList.add('border-fgu/20');
      } else {
        node.classList.add('border-warm-gold/25');
      }

      const typeLabel = type === 'academic' ? '學術' : '雇主';
      $('.contact-card-title', node).textContent = `${typeLabel}聯絡人 #${index + 1}`;

      const jobList = type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES;
      setComboboxField($('.field-title', node), TITLES, contact.title, contact.titleOther);
      setComboboxField($('.field-job-title', node), jobList, contact.jobTitle, contact.jobOther, { pluralOther: true });
      setComboboxField($('.field-industry', node), INDUSTRIES, contact.industry, contact.industryOther);
      setComboboxField(
        $('.field-country', node),
        COUNTRIES,
        contact.country || DEFAULT_COUNTRY,
        contact.countryOther,
      );
      setComboboxField($('.field-subject', node), SUBJECTS, contact.subject, contact.subjectOther, {
        pluralOther: true,
      });

      $('.field-first-name', node).value = contact.firstName;
      $('.field-last-name', node).value = contact.lastName;
      $('.field-department', node).value = contact.department;
      $('.field-institution', node).value = contact.institution;
      $('.field-email', node).value = contact.email;
      $('.field-phone', node).value = contact.phone;

      applyTypeUI(node, type);

      node.addEventListener('input', () => syncCardToModel(node));
      node.addEventListener('change', () => syncCardToModel(node));

      $('.btn-remove-contact', node).addEventListener('click', () => {
        setList(type, getList(type).filter((c) => c.id !== contact.id));
        renderAllCards();
        saveState();
      });

      return node;
    }

    function renderAllCards() {
      const academicContainer = $('#academic-contacts-container');
      const employerContainer = $('#employer-contacts-container');
      if (!academicContainer || !employerContainer) return;

      academicContainer.innerHTML = '';
      employerContainer.innerHTML = '';
      try {
        academicContacts.forEach((c, i) => academicContainer.appendChild(renderContactCard(c, i, 'academic')));
        employerContacts.forEach((c, i) => employerContainer.appendChild(renderContactCard(c, i, 'employer')));
      } catch (err) {
        console.error(err);
        showError('聯絡人表單渲染失敗，請重新整理頁面後再試。');
        return;
      }
      updateContactCount();
    }

    /** @param {(info: { label: string, percent: number }) => void} [onProgress] */
    async function renderAllCardsBatched(onProgress) {
      const academicContainer = $('#academic-contacts-container');
      const employerContainer = $('#employer-contacts-container');
      if (!academicContainer || !employerContainer) return;

      academicContainer.innerHTML = '';
      employerContainer.innerHTML = '';

      const total = academicContacts.length + employerContacts.length;
      let done = 0;
      const BATCH = 8;

      const tick = (label) => {
        if (!onProgress) return;
        const percent = total ? Math.round((done / total) * 100) : 100;
        onProgress({ label, percent });
      };

      try {
        for (let i = 0; i < academicContacts.length; i += BATCH) {
          academicContacts.slice(i, i + BATCH).forEach((c, j) => {
            academicContainer.appendChild(renderContactCard(c, i + j, 'academic'));
            done += 1;
          });
          tick(`載入學術聯絡人（${done}/${total}）…`);
          await new Promise((r) => requestAnimationFrame(r));
        }
        for (let i = 0; i < employerContacts.length; i += BATCH) {
          employerContacts.slice(i, i + BATCH).forEach((c, j) => {
            employerContainer.appendChild(renderContactCard(c, i + j, 'employer'));
            done += 1;
          });
          tick(`載入雇主聯絡人（${done}/${total}）…`);
          await new Promise((r) => requestAnimationFrame(r));
        }
      } catch (err) {
        console.error(err);
        showError('聯絡人表單渲染失敗，請重新整理頁面後再試。');
        return;
      }

      updateContactCount();
      onProgress?.({ label: '載入完成', percent: 100 });
    }

    /** @param {'academic'|'employer'} type */
    function addContact(type) {
      const list = getList(type);
      if (list.length >= MAX_CONTACTS) return;
      list.push(emptyContact(type));
      renderAllCards();
      saveState();
      showError('');
      const container = type === 'academic' ? $('#academic-contacts-container') : $('#employer-contacts-container');
      const lastCard = container?.lastElementChild;
      lastCard?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function showError(err) {
      const el = $('#form-error');
      const msg = typeof err === 'string' ? err : err?.message;
      if (!msg) {
        el.classList.add('hidden');
        el.textContent = '';
        clearFieldFlash();
        return;
      }
      el.textContent = msg;
      el.classList.remove('hidden');
      if (err && typeof err === 'object') focusInvalidField(err);
      else el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function clearFieldFlash() {
      $$('.field-flash, .section-flash').forEach((el) => {
        el.classList.remove('field-flash', 'section-flash');
      });
    }

    /** @param {{ message: string, globalId?: string, contactId?: string, field?: string, section?: string }} err */
    function focusInvalidField(err) {
      clearFieldFlash();
      let target = null;

      if (err.globalId) {
        target = document.getElementById(err.globalId);
      } else if (err.contactId && err.field) {
        const card = document.querySelector(`[data-contact-id="${err.contactId}"]`);
        if (card) {
          target = card.querySelector(err.field);
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } else if (err.section === 'academic') {
        target = $('#section-academic');
        target?.classList.add('section-flash');
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      } else if (err.section === 'employer') {
        target = $('#section-employer');
        target?.classList.add('section-flash');
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      if (!target) return;

      if (target.classList.contains('hidden')) target.classList.remove('hidden');

      target.classList.add('field-flash');
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (typeof target.focus === 'function') {
        try {
          target.focus({ preventScroll: true });
        } catch {
          target.focus();
        }
      }

      const removeFlash = () => {
        target.classList.remove('field-flash');
        target.removeEventListener('input', removeFlash);
        target.removeEventListener('change', removeFlash);
      };
      target.addEventListener('input', removeFlash, { once: true });
      target.addEventListener('change', removeFlash, { once: true });
    }

    /** @param {string} message @param {{ contactId?: string, field?: string, globalId?: string, section?: string }} [loc] */
    function validationErr(message, loc = {}) {
      return { message, ...loc };
    }

    function validateEmail(email) {
      const e = normalizeEmail(email);
      if (!e) return 'Email 為必填';
      if (EMAIL_FORBIDDEN.test(e)) return 'Email 含有不允許的字元';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)) return 'Email 格式不正確';
      return null;
    }

    /** @param {typeof academicContacts} list @param {'academic'|'employer'} type */
    function validateContactList(list, type) {
      const label = type === 'academic' ? '學術聯絡人' : '雇主聯絡人';
      for (let i = 0; i < list.length; i++) {
        const c = list[i];
        const n = i + 1;
        const loc = (field) => ({ contactId: c.id, field });
        if (!trimVal(c.title)) return validationErr(`${label} #${n}：請填寫 Title。`, loc('.field-title'));
        if (c.title === 'Other' && !trimVal(c.titleOther)) {
          return validationErr(`${label} #${n}：Title 請填寫具體內容（不可只填 Other）。`, loc('.field-title'));
        }
        if (!trimVal(c.firstName)) return validationErr(`${label} #${n}：請填寫 First Name。`, loc('.field-first-name'));
        if (!trimVal(c.lastName)) return validationErr(`${label} #${n}：請填寫 Last Name。`, loc('.field-last-name'));
        if (!trimVal(c.jobTitle)) {
          return validationErr(`${label} #${n}：請填寫 ${type === 'academic' ? 'Job Title' : 'Position'}。`, loc('.field-job-title'));
        }
        if (c.jobTitle === 'Other' && !trimVal(c.jobOther)) {
          return validationErr(`${label} #${n}：${type === 'academic' ? 'Job Title' : 'Position'} 請填寫具體內容。`, loc('.field-job-title'));
        }
        if (type === 'academic') {
          if (!trimVal(c.department)) return validationErr(`${label} #${n}：請填寫 Department。`, loc('.field-department'));
          if (!trimVal(c.subject)) return validationErr(`${label} #${n}：請填寫 Subject。`, loc('.field-subject'));
          if (c.subject === 'Other' && !trimVal(c.subjectOther)) {
            return validationErr(`${label} #${n}：Subject 請填寫具體內容。`, loc('.field-subject'));
          }
        } else {
          if (!trimVal(c.industry)) return validationErr(`${label} #${n}：請填寫 Industry。`, loc('.field-industry'));
          if (c.industry === 'Other' && !trimVal(c.industryOther)) {
            return validationErr(`${label} #${n}：Industry 請填寫具體內容。`, loc('.field-industry'));
          }
        }
        if (!trimVal(c.institution)) {
          return validationErr(
            `${label} #${n}：請填寫 ${type === 'academic' ? 'Institution' : 'Company Name'}。`,
            loc('.field-institution'),
          );
        }
        if (!trimVal(c.country)) return validationErr(`${label} #${n}：請填寫 Country or Territory。`, loc('.field-country'));
        if (c.country === 'Other' && !trimVal(c.countryOther)) {
          return validationErr(`${label} #${n}：Country 請填寫具體內容。`, loc('.field-country'));
        }
        const emailErr = validateEmail(c.email);
        if (emailErr) return validationErr(`${label} #${n}：${emailErr}。`, loc('.field-email'));
      }
      return null;
    }

    function validateAll() {
      const unit = trimVal($('#submitter-unit').value);
      const submitter = trimVal($('#submitter-name').value);
      if (!unit) return validationErr('請填寫提交單位。', { globalId: 'submitter-unit' });
      if (!submitter) return validationErr('請填寫提交人姓名。', { globalId: 'submitter-name' });
      if (!academicContacts.length && !employerContacts.length) {
        return validationErr('請至少新增一筆學術或雇主聯絡人。', { section: 'academic' });
      }
      return validateContactList(academicContacts, 'academic') || validateContactList(employerContacts, 'employer');
    }

    /** @param {'en'|'zh'} lang */
    function toAcademicExcelRow(c, lang = 'en') {
      return [
        lang === 'zh' ? SOURCE_ZH : SOURCE_EN,
        resolveTitle(c, lang),
        collapseSpaces(c.firstName),
        collapseSpaces(c.lastName),
        resolveJobTitle(c, lang),
        collapseSpaces(c.department),
        collapseSpaces(c.institution),
        resolveCountry(c, lang),
        normalizeEmail(c.email),
        resolveSubject(c, lang),
        normalizePhone(c.phone),
      ];
    }

    /** @param {'en'|'zh'} lang */
    function toEmployerExcelRow(c, lang = 'en') {
      return [
        lang === 'zh' ? SOURCE_ZH : SOURCE_EN,
        resolveTitle(c, lang),
        collapseSpaces(c.firstName),
        collapseSpaces(c.lastName),
        resolveJobTitle(c, lang),
        resolveDeptIndustry(c, lang),
        collapseSpaces(c.institution),
        resolveCountry(c, lang),
        normalizeEmail(c.email),
        normalizePhone(c.phone),
      ];
    }

    function buildPreviewCard(c, index, type) {
      const jobList = type === 'academic' ? ACADEMIC_JOB_TITLES : EMPLOYER_JOB_TITLES;
      const typeLabel = type === 'academic' ? '學術' : '雇主';
      const titleText =
        c.title === 'Other'
          ? formatSimpleOther(c.titleOther, 'zh') + ' / ' + formatSimpleOther(c.titleOther, 'en')
          : c.title === 'Ven'
            ? formatVenTitle('zh') + ' / ' + formatVenTitle('en')
            : displayOpt(TITLES, c.title);
      const jobText =
        c.jobTitle === 'Other'
          ? formatOther(c.jobOther, 'zh') + ' / ' + formatOther(c.jobOther, 'en')
          : displayOpt(jobList, c.jobTitle);
      const deptText =
        type === 'academic'
          ? trimVal(c.department)
          : c.industry === 'Other'
            ? formatIndustryOther(c.industryOther, 'zh') + ' / ' + formatIndustryOther(c.industryOther, 'en')
            : displayOpt(INDUSTRIES, c.industry);
      const countryText =
        c.country === 'Other'
          ? formatSimpleOther(c.countryOther, 'zh') + ' / ' + formatSimpleOther(c.countryOther, 'en')
          : displayOpt(COUNTRIES, c.country);
      const subjectText =
        type === 'academic'
          ? c.subject === 'Other'
            ? formatOther(c.subjectOther, 'zh') + ' / ' + formatOther(c.subjectOther, 'en')
            : displayOpt(SUBJECTS, c.subject)
          : '—';

      const fields = [
        ['Title', titleText],
        ['First Name', trimVal(c.firstName)],
        ['Last Name', trimVal(c.lastName)],
        [type === 'academic' ? 'Job Title' : 'Position', jobText],
        [type === 'academic' ? 'Department' : 'Industry', deptText],
        [type === 'academic' ? 'Institution' : 'Company Name', trimVal(c.institution)],
        ['Country or Territory', countryText],
        ['Email', trimVal(c.email)],
        ...(type === 'academic' ? [['Subject', subjectText]] : []),
        ['Phone (Optional)', trimVal(c.phone) || '—'],
      ];

      const card = document.createElement('article');
      card.className = type === 'academic' ? 'preview-card--academic' : 'preview-card--employer';
      const badge =
        type === 'academic'
          ? '<span class="preview-badge--academic">學術 Academic</span>'
          : '<span class="preview-badge--employer">雇主 Employer</span>';

      card.innerHTML = `
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 pb-2">
          <h3 class="text-sm font-semibold text-slate-900">${typeLabel}聯絡人 #${index + 1}</h3>
          ${badge}
        </div>
        <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
          ${fields
            .map(
              ([label, value]) => `
            <div class="min-w-0">
              <dt class="text-xs font-medium text-slate-500">${label}</dt>
              <dd class="mt-0.5 break-words text-sm text-slate-800">${escapeHtml(value)}</dd>
            </div>`,
            )
            .join('')}
        </dl>
      `;
      return card;
    }

    function renderPreview() {
      const unit = trimVal($('#submitter-unit').value);
      const submitter = trimVal($('#submitter-name').value);
      $('#preview-meta').textContent = `提交單位：${unit}　｜　提交人姓名：${submitter}　｜　學術 ${academicContacts.length} 筆、雇主 ${employerContacts.length} 筆（資料已正規化；Excel 均含中文／English 分頁）`;

      const list = $('#preview-list');
