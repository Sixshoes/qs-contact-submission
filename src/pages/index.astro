    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function safeFilePart(name) {
      return trimVal(name).replace(/[\\/:*?"<>|]/g, '_').slice(0, 80) || '未命名單位';
    }

    function fileTimestamp() {
      const d = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;
    }

    /** @type {string[]} */
    /** @type {{ filename: string, blob: Blob }[]} */
    let downloadArtifacts = [];

    function renderDownloadPanel() {
      const panel = $('#download-panel');
      const btns = $('#download-buttons');
      btns.innerHTML = '';
      if (!downloadArtifacts.length) {
        panel.classList.add('hidden');
        return;
      }
      panel.classList.remove('hidden');

      downloadArtifacts.forEach(({ filename, blob }) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-primary text-sm';
        btn.textContent = `⬇ ${filename}`;
        btn.addEventListener('click', () => downloadBlob(blob, filename));
        btns.appendChild(btn);
      });

      if (downloadArtifacts.length > 1) {
        const allBtn = document.createElement('button');
        allBtn.type = 'button';
        allBtn.className = 'btn-secondary text-sm';
        allBtn.textContent = `⬇ 一次下載全部（${downloadArtifacts.length} 個檔案）`;
        allBtn.addEventListener('click', () => downloadBlobsSequential(downloadArtifacts));
        btns.appendChild(allBtn);
      }
    }

    function rowToObject(headers, values) {
      const obj = {};
      headers.forEach((h, i) => {
        obj[h] = values[i] ?? '';
      });
      return obj;
    }

    function buildCloudPayload(submissionId) {
      const unit = trimVal($('#submitter-unit').value);
      const submitter = trimVal($('#submitter-name').value);
      return {
        submissionId,
        unit,
        submitter,
        submittedAt: new Date().toISOString(),
        academic: academicContacts.map((c) =>
          rowToObject(ACADEMIC_EXCEL_HEADERS_EN, toAcademicExcelRow(c, 'en')),
        ),
        employer: employerContacts.map((c) =>
          rowToObject(EMPLOYER_EXCEL_HEADERS_EN, toEmployerExcelRow(c, 'en')),
        ),
      };
    }

    /**
     * Apps Script：text/plain 避開 CORS preflight；必須收到 {"ok":true} 才算成功。
     * 若瀏覽器被 CORS 擋住讀取，改走隱藏 iframe form POST（仍會寫入試算表）。
     */
    async function submitToGoogleSheets(payload) {
      if (!GOOGLE_SCRIPT_URL) {
        throw new Error('尚未設定 PUBLIC_GOOGLE_SCRIPT_URL');
      }
      try {
        return await submitViaFetch_(payload);
      } catch (fetchErr) {
        console.warn('fetch 提交失敗，改用 form 備援', fetchErr);
        await submitViaForm_(payload);
        return { submissionId: payload.submissionId, timestamp: '', via: 'form' };
      }
    }

    async function submitViaFetch_(payload) {
      const res = await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
        redirect: 'follow',
      });
      const text = await res.text();
      let parsed = null;
      try {
        parsed = JSON.parse(text);
      } catch {
        throw new Error('伺服器回應不是 JSON（可能尚未重新部署腳本）');
      }
      if (!parsed || parsed.ok !== true) {
        throw new Error((parsed && parsed.error) || `寫入失敗（HTTP ${res.status}）`);
      }
      return {
        submissionId: parsed.submissionId || payload.submissionId,
        timestamp: parsed.timestamp || '',
        spreadsheetUrl: parsed.spreadsheetUrl || '',
        via: 'fetch',
      };
    }

    function submitViaForm_(payload) {
      return new Promise((resolve, reject) => {
        const iframeName = 'qs_gas_frame';
        let iframe = document.getElementById(iframeName);
        if (!iframe) {
          iframe = document.createElement('iframe');
          iframe.name = iframeName;
          iframe.id = iframeName;
          iframe.title = 'gas';
          iframe.style.cssText = 'position:absolute;width:0;height:0;border:0;visibility:hidden';
          document.body.appendChild(iframe);
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = GOOGLE_SCRIPT_URL;
        form.target = iframeName;
        form.style.display = 'none';

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'payload';
        input.value = JSON.stringify(payload);
        form.appendChild(input);
        document.body.appendChild(form);

        const timer = setTimeout(() => {
          form.remove();
          resolve();
        }, 2500);

        iframe.onload = () => {
          clearTimeout(timer);
          form.remove();
          resolve();
        };

        try {
          form.submit();
        } catch (err) {
          clearTimeout(timer);
          form.remove();
          reject(err);
        }
      });
    }

    function setSubmitProgress({ label, percent, visible = true, footnote = undefined }) {
      const wrap = $('#submit-progress');
      const bar = $('#submit-progress-bar');
      const labelEl = $('#submit-progress-label');
      const pctEl = $('#submit-progress-percent');
      const footnoteEl = $('#submit-progress-footnote');
      if (!wrap) return;
      if (!visible) {
        wrap.classList.add('hidden');
        wrap.classList.remove('import-progress--busy', 'import-progress--sheet');
        wrap.setAttribute('aria-busy', 'false');
        footnoteEl?.classList.add('hidden');
        return;
      }
      wrap.classList.remove('hidden');
      wrap.classList.add('import-progress--busy');
      wrap.setAttribute('aria-busy', 'true');
      if (labelEl) labelEl.textContent = formatProgressLabel(label, '提交中');
      const pct = Math.min(100, Math.max(0, percent ?? 0));
      if (bar) bar.style.width = `${pct}%`;
      if (pctEl) pctEl.textContent = `${pct}%`;
      if (footnoteEl && footnote !== undefined) {
        if (footnote) {
          footnoteEl.textContent = footnote;
          footnoteEl.classList.remove('hidden');
          wrap.classList.add('import-progress--sheet');
        } else {
          footnoteEl.textContent = '';
          footnoteEl.classList.add('hidden');
          wrap.classList.remove('import-progress--sheet');
        }
      }
    }

    function hideSubmitProgress() {
      setSubmitProgress({ visible: false });
    }

    async function submitToGoogleSheetsWithProgress(payload, onProgress) {
      const totalContacts = payload.academic.length + payload.employer.length;
      const sheetFootnote = '試算表寫入中，請稍候勿關閉頁面；網路較慢時進度可能暫停在 72% 左右，屬正常現象。';
      onProgress({
        label: `上傳至試算表（${totalContacts} 筆）…`,
        percent: 22,
        footnote: sheetFootnote,
      });

      let pct = 22;
      const timer = setInterval(() => {
        if (pct < 72) {
          pct += 1;
          onProgress({
            label: `上傳至試算表（${totalContacts} 筆）…`,
            percent: pct,
            footnote: sheetFootnote,
          });
        }
      }, 180);

      try {
        return await submitToGoogleSheets(payload);
      } finally {
        clearInterval(timer);
        onProgress({ label: '試算表寫入完成', percent: 75, footnote: '' });
      }
    }

    async function handleSubmit() {
      normalizeAllData();
      const unit = safeFilePart($('#submitter-unit').value);
      const ts = fileTimestamp();
      downloadArtifacts = [];
      lastSubmitMode = null;
      lastSubmissionId = '';
      lastSubmitTimestamp = '';
      lastSubmitError = '';

      const btn = $('#btn-submit');
      const backBtn = $('#btn-back');
      const unlockInput = $('#confirm-unlock');
      const prevLabel = btn.textContent;
      btn.disabled = true;
      backBtn.disabled = true;
      unlockInput.disabled = true;
      btn.textContent = '提交中…';
      setSubmitProgress({ label: '準備提交資料…', percent: 5 });

      try {
        await new Promise((r) => requestAnimationFrame(r));
        setSubmitProgress({
          label: `整理聯絡人（學術 ${academicContacts.length}、雇主 ${employerContacts.length}）…`,
          percent: 12,
        });

        const submissionId = `qs_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`;
        let cloudOk = false;
        const payload = buildCloudPayload(submissionId);

        if (GOOGLE_SCRIPT_URL) {
          try {
            const cloud = await submitToGoogleSheetsWithProgress(payload, (progress) =>
              setSubmitProgress(progress),
            );
            lastSubmissionId = cloud.submissionId;
            lastSubmitTimestamp = cloud.timestamp || '';
            cloudOk = true;
            lastSubmitMode = 'online';
          } catch (cloudErr) {
            console.error(cloudErr);
            lastSubmitError = cloudErr?.message || String(cloudErr);
            lastSubmitMode = 'offline';
            setSubmitProgress({ label: '試算表寫入失敗，改產生備份…', percent: 75, footnote: '' });
          }
        } else {
          lastSubmitMode = 'offline';
          lastSubmitError = '尚未設定雲端提交網址';
          setSubmitProgress({ label: '略過雲端寫入，產生 Excel 備份…', percent: 78 });
        }

        const queue = [];
        if (academicContacts.length) {
          setSubmitProgress({ label: `產生學術 Excel（${academicContacts.length} 筆）…`, percent: 82 });
          const name = `QS_學術聯絡人名單_${unit}_${ts}.xlsx`;
          const blob = await createAcademicWorkbookBlob({
            headersZh: ACADEMIC_EXCEL_HEADERS_ZH,
            headersEn: ACADEMIC_EXCEL_HEADERS_EN,
            rowsZh: academicContacts.map((c) => toAcademicExcelRow(c, 'zh')),
            rowsEn: academicContacts.map((c) => toAcademicExcelRow(c, 'en')),
          });
          queue.push({ filename: name, blob });
        }
        if (employerContacts.length) {
          setSubmitProgress({ label: `產生雇主 Excel（${employerContacts.length} 筆）…`, percent: 92 });
          const name = `QS_雇主聯絡人名單_${unit}_${ts}.xlsx`;
          const blob = await createEmployerWorkbookBlob({
            headersZh: EMPLOYER_EXCEL_HEADERS_ZH,
            headersEn: EMPLOYER_EXCEL_HEADERS_EN,
            rowsZh: employerContacts.map((c) => toEmployerExcelRow(c, 'zh')),
            rowsEn: employerContacts.map((c) => toEmployerExcelRow(c, 'en')),
          });
          queue.push({ filename: name, blob });
        }

        downloadArtifacts = queue;
        setSubmitProgress({ label: '提交完成', percent: 100 });
        await new Promise((r) => setTimeout(r, 350));
        hideSubmitProgress();
        goToStep3({ cloudOk });
      } catch (err) {
        console.error(err);
        hideSubmitProgress();
        alert('提交時發生錯誤，請再試一次。');
      } finally {
        btn.textContent = prevLabel;
        unlockInput.disabled = false;
        backBtn.disabled = false;
        btn.disabled = unlockInput.value.trim() !== UNLOCK_PHRASE;
      }
    }

    function goToStep3({ cloudOk = false } = {}) {
      const titleEl = $('#success-title');
      const descEl = $('#success-desc');
      const idLine = $('#submission-id-line');

      if (cloudOk) {
        titleEl.textContent = '已提交成功';
        descEl.textContent = '下方 Excel 可下載備份。';
        if (lastSubmissionId) {
          idLine.textContent = lastSubmitTimestamp
            ? `提交編號：${lastSubmissionId}　｜　時間戳：${lastSubmitTimestamp}`
            : `提交編號：${lastSubmissionId}`;
          idLine.classList.remove('hidden');
        } else {
          idLine.classList.add('hidden');
        }
      } else {
        titleEl.textContent = '送出失敗';
        descEl.textContent = lastSubmitError
          ? `無法寫入試算表（${lastSubmitError}）。請下載下方 Excel 備份。`
          : '無法寫入試算表。請下載下方 Excel 備份。';
        idLine.classList.add('hidden');
      }

      renderDownloadPanel();
      showStep(3);
    }

    function clearAllFormData() {
      localStorage.removeItem(STORAGE_KEY);
      $('#submitter-unit').value = '';
      $('#submitter-name').value = '';
      academicContacts = [];
      employerContacts = [];
      downloadArtifacts = [];
      lastSubmitMode = null;
      lastSubmissionId = '';
      lastSubmitTimestamp = '';
      lastSubmitError = '';
      renderAllCards();
      showError('');
      $('#confirm-unlock').value = '';
      $('#btn-submit').disabled = true;
      showStep(1);
    }

    function openClearModal() {
      $('#clear-confirm').value = '';
      $('#btn-clear-confirm').disabled = true;
      $('#clear-modal').classList.remove('hidden');
      $('#clear-confirm').focus();
    }

    function closeClearModal() {
      $('#clear-modal').classList.add('hidden');
      $('#clear-confirm').value = '';
      $('#btn-clear-confirm').disabled = true;
    }

    function bindClearModal() {
      $('#btn-open-clear').addEventListener('click', openClearModal);
      $('#btn-reset').addEventListener('click', openClearModal);
      $('#btn-back-to-form').addEventListener('click', () => {
        renderAllCards();
        showStep(1);
      });
      $('#btn-clear-cancel').addEventListener('click', closeClearModal);
      $('#clear-modal-backdrop').addEventListener('click', closeClearModal);

      $('#clear-confirm').addEventListener('input', (e) => {
        $('#btn-clear-confirm').disabled = e.target.value.trim() !== CLEAR_PHRASE;
      });

      $('#clear-confirm').addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && e.target.value.trim() === CLEAR_PHRASE) {
          e.preventDefault();
          $('#btn-clear-confirm').click();
        }
        if (e.key === 'Escape') closeClearModal();
      });

      $('#btn-clear-confirm').addEventListener('click', () => {
        if ($('#clear-confirm').value.trim() !== CLEAR_PHRASE) return;
        closeClearModal();
        clearAllFormData();
      });
    }

    function bindImport() {
      const fileInput = $('#import-file');
      const parseBtn = $('#btn-parse-import');
      const clearBtn = $('#btn-clear-import');
      const zone = $('#import-zone');
      let selectedFile = null;

      function setFile(file) {
        selectedFile = file || null;
        $('#import-file-name').textContent = selectedFile ? selectedFile.name : '';
        parseBtn.disabled = !selectedFile;
        clearBtn.classList.toggle('hidden', !selectedFile);
        if (!selectedFile) resetImportResult();
      }

      function setImportProgress({ label, percent, visible = true }) {
        const wrap = $('#import-progress');
        const bar = $('#import-progress-bar');
        const labelEl = $('#import-progress-label');
        const pctEl = $('#import-progress-percent');
        if (!wrap) return;
        if (!visible) {
          wrap.classList.add('hidden');
          wrap.classList.remove('import-progress--busy');
          wrap.setAttribute('aria-busy', 'false');
          return;
        }
        wrap.classList.remove('hidden');
        wrap.classList.add('import-progress--busy');
        wrap.setAttribute('aria-busy', 'true');
        if (labelEl) labelEl.textContent = formatProgressLabel(label, '處理中');
        const pct = Math.min(100, Math.max(0, percent ?? 0));
        if (bar) bar.style.width = `${pct}%`;
        if (pctEl) pctEl.textContent = `${pct}%`;
      }

      function hideImportProgress() {
        setImportProgress({ visible: false });
      }

      function resetImportResult() {
        pendingImport = null;
        hideImportProgress();
        $('#import-result').classList.add('hidden');
        $('#import-errors-wrap').classList.add('hidden');
        $('#import-errors').innerHTML = '';
      }

      function hasExistingContactData() {
        return academicContacts.length > 0 || employerContacts.length > 0;
      }

      function renderImportErrors(result) {
        pendingImport = null;
        $('#import-result').classList.remove('hidden');
        $('#import-summary').textContent = `驗證未通過：學術 ${result.summary.academicCount} 筆、雇主 ${result.summary.employerCount} 筆（請修正錯誤後重新上傳）。`;

        const errWrap = $('#import-errors-wrap');
        const errList = $('#import-errors');
        if (result.errors.length) {
          errWrap.classList.remove('hidden');
          errList.innerHTML = result.errors
            .map(
              (e) =>
                `<li>${escapeHtml(e.sheet)}${e.row ? ` 第 ${e.row} 列` : ''} · ${escapeHtml(e.field)}：${escapeHtml(e.message)}</li>`,
            )
            .join('');
        } else {
          errWrap.classList.add('hidden');
          errList.innerHTML = '';
        }
      }

      async function confirmAndApplyImport(result) {
        if (hasExistingContactData()) {
          const total = academicContacts.length + employerContacts.length;
          const ok = confirm(
            `目前已有 ${total} 筆聯絡人資料，匯入 Excel 將覆蓋現有內容。\n\n確定要繼續嗎？`,
          );
          if (!ok) {
            $('#import-result').classList.remove('hidden');
            $('#import-summary').textContent = `已取消匯入（驗證已通過：學術 ${result.summary.academicCount} 筆、雇主 ${result.summary.employerCount} 筆）。`;
            $('#import-errors-wrap').classList.add('hidden');
            pendingImport = null;
            return;
          }
        }
        await applyImportResult(result);
      }

      async function applyImportResult(result) {
        const toContact = (c, type) => ({
          ...emptyContact(type),
          ...c,
          id: uid(),
          type,
        });

        const newAcademic = result.academic.map((c) => toContact(c, 'academic'));
        const newEmployer = result.employer.map((c) => toContact(c, 'employer'));

        academicContacts = newAcademic;
        employerContacts = newEmployer;

        saveState();
        showError('');
        resetImportResult();
        setFile(null);
        fileInput.value = '';

        setImportProgress({ label: '準備預覽名單…', percent: 40 });
        await new Promise((r) => requestAnimationFrame(r));
        updateContactCount();
        renderPreview();
        setImportProgress({ label: '預覽完成', percent: 100 });
        await new Promise((r) => setTimeout(r, 200));
        hideImportProgress();
        showStep(2);
      }

      zone?.addEventListener('dragover', (e) => {
        e.preventDefault();
        zone.classList.add('import-zone--active');
      });
      zone?.addEventListener('dragleave', () => zone.classList.remove('import-zone--active'));
      zone?.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('import-zone--active');
        const file = e.dataTransfer?.files?.[0];
        if (file) setFile(file);
      });

      fileInput?.addEventListener('change', (e) => {
        const file = e.target.files?.[0];
        setFile(file || null);
      });

      clearBtn?.addEventListener('click', () => {
        fileInput.value = '';
        setFile(null);
      });

      parseBtn?.addEventListener('click', async () => {
        if (!selectedFile) return;
        parseBtn.disabled = true;
        clearBtn.disabled = true;
        parseBtn.textContent = '驗證中…';
        setImportProgress({ label: '準備讀取檔案…', percent: 0 });
        try {
          const result = await parseImportFile(selectedFile, {
            maxContacts: MAX_CONTACTS,
            onProgress: ({ label, percent }) => setImportProgress({ label, percent }),
          });
          if (result.ok) {
            await confirmAndApplyImport(result);
          } else {
            renderImportErrors(result);
          }
        } catch (err) {
          renderImportErrors({
            ok: false,
            academic: [],
            employer: [],
            errors: [{ sheet: '—', row: 0, field: '檔案', message: err?.message || String(err) }],
            summary: { academicCount: 0, employerCount: 0 },
          });
        } finally {
          hideImportProgress();
          parseBtn.textContent = '解析並驗證';
          parseBtn.disabled = !selectedFile;
          clearBtn.disabled = false;
        }
      });
    }

    function bindGlobal() {
      $('#submitter-unit').addEventListener('input', saveState);
      $('#submitter-name').addEventListener('input', saveState);

      $('#btn-add-academic').addEventListener('click', () => addContact('academic'));

      $('#btn-add-employer').addEventListener('click', () => addContact('employer'));

      $('#btn-preview').addEventListener('click', () => {
        normalizeAllData();
        const err = validateAll();
        if (err) {
          showError(err);
          return;
        }
        showError('');
        renderPreview();
        showStep(2);
      });

      $('#btn-back').addEventListener('click', () => {
        renderAllCards();
        showStep(1);
      });

      $('#confirm-unlock').addEventListener('input', (e) => {
        $('#btn-submit').disabled = e.target.value.trim() !== UNLOCK_PHRASE;
      });

      $('#btn-submit').addEventListener('click', () => {
        if ($('#confirm-unlock').value.trim() !== UNLOCK_PHRASE) return;
        handleSubmit();
      });
    }

    function init() {
      populateAllDatalists();
      bindGlobal();
      bindImport();
      bindClearModal();
      const hint = $('#submit-hint');
      if (hint && !GOOGLE_SCRIPT_URL) {
        hint.textContent = '可複製上方「我確定提交」以完成提交。送出後請下載 Excel 備份。';
      }
      const saved = loadState();
      if (saved && (saved.academicContacts?.length || saved.employerContacts?.length)) {
        $('#submitter-unit').value = saved.unit || '';
        $('#submitter-name').value = saved.submitter || '';
        academicContacts = (saved.academicContacts || []).map((c) => ({
          ...emptyContact('academic'),
          ...c,
          id: c.id || uid(),
          type: 'academic',
        }));
        employerContacts = (saved.employerContacts || []).map((c) => ({
          ...emptyContact('employer'),
          ...c,
          id: c.id || uid(),
          type: 'employer',
        }));
        renderAllCards();
        if (saved.step === 2) {
          const err = validateAll();
          if (!err) {
            renderPreview();
            showStep(2);
            return;
          }
        }
        showStep(1);
      } else {
        academicContacts = [];
        employerContacts = [];
        renderAllCards();
        showStep(1);
      }
    }

    init();
  </script>
</Layout>
